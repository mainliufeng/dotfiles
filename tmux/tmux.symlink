#!/bin/sh
ln -svf ~/dotfiles/tmux/.tmux.conf ~/.tmux.conf
ln -svf ~/dotfiles/tmux/.tmux.conf.local ~/.tmux.conf.local

mkdir -p ~/.config/tmuxinator/
for yml_file in ~/dotfiles/tmux/tmuxinator/*.yml; do
    ln -svf ~/dotfiles/tmux/tmuxinator/"$(basename $yml_file)" ~/.config/tmuxinator/"$(basename $yml_file)"
done
