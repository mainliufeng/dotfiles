{
  "version": 1,
  "targets": {
    "codex": {
      "skills_dir": "~/.codex/skills",
      "agents_file": "~/.codex/AGENTS.md"
    },
    "claude": {
      "skills_dir": "~/.claude/skills",
      "agents_file": "~/.claude/CLAUDE.md"
    }
  },
  "agent_md_fragments": {
    "base": "agent_md_fragments/base.md",
    "debug": "agent_md_fragments/debug.md",
    "solution-discipline": "agent_md_fragments/solution-discipline.md",
    "superpowers": "agent_md_fragments/superpowers.md"
  },
  "profiles": {
    "codex": {
      "agent_md_fragments": ["base", "superpowers"]
    },
    "claude": {
      "agent_md_fragments": ["base", "superpowers"]
    }
  },
  "project_overrides": [
    {
      "path": "~/dotfiles",
      "target": "codex",
      "file": "AGENTS.override.md",
      "agent_md_fragments": ["base"]
    }
  ],
  "skills": [
