{
  "layout": "swimlane",
  "width": 1600, "height": 1100,
  "slug": "swimlane-agent",
  "title": "一次工具调用的三方协作",
  "subtitle": "用户、Agent、工具三条泳道",
  "description": "用户提问后，Agent 决定调用工具，工具执行并返回结果，Agent 校验后回复用户。",
  "lanes": [
    {"id": "user", "title": "用户", "color": "teal"},
    {"id": "agent", "title": "Agent", "color": "amber"},
    {"id": "tool", "title": "工具", "color": "violet"}
  ],
  "steps": [
    {"id": "ask", "lane": "user", "label": "提问", "body": "自然语言", "x": 0.08},
    {"id": "plan", "lane": "agent", "label": "决定调用", "body": "选择工具", "x": 0.3},
    {"id": "exec", "lane": "tool", "label": "执行", "body": "Shell/编辑器", "x": 0.55},
    {"id": "verify", "lane": "agent", "label": "校验结果", "body": "参数与权限", "x": 0.75},
    {"id": "reply", "lane": "user", "label": "收到回复", "body": "流式输出", "x": 0.92}
  ],
  "edges": [
    {"from": "ask", "to": "plan", "label": "请求"},
    {"from": "plan", "to": "exec", "label": "调用"},
    {"from": "exec", "to": "verify", "label": "结果"},
    {"from": "verify", "to": "reply", "label": "回复"}
  ]
}
