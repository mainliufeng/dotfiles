{
  "layout": "flow",
  "width": 1200,
  "height": 1680,
  "title": "Agent Loop：一条主线，一个返回回路",
  "subtitle": "Task Done 向右结束，Tool Call 向下执行并回写上下文",
  "groups": [
    {"id": "harness", "title": "HARNESS", "x": 120, "y": 140, "w": 960, "h": 1380, "color": "teal"}
  ],
  "nodes": [
    {"id": "context", "label": "1 组装上下文", "body": "指令、历史、工具定义", "x": 310, "y": 210, "w": 580, "h": 150, "fill": "surface_alt", "stroke": "teal"},
    {"id": "model", "label": "2 调用模型", "body": "发送请求并接收流式输出", "x": 310, "y": 430, "w": 580, "h": 150, "fill": "surface_alt", "stroke": "violet"},
    {"id": "decision", "label": "3 解析输出", "body": "判断最终答案或工具调用", "x": 310, "y": 650, "w": 580, "h": 150, "fill": "surface_alt", "stroke": "amber"},
    {"id": "done", "label": "最终结果", "body": "Task Done", "x": 950, "y": 880, "w": 210, "h": 130, "fill": "surface_alt", "stroke": "coral"},
    {"id": "validate", "label": "4 校验工具调用", "body": "参数、权限、审批策略", "x": 310, "y": 900, "w": 580, "h": 150, "fill": "surface_alt", "stroke": "amber"},
    {"id": "execute", "label": "5 执行工具", "body": "Shell、编辑器、浏览器", "x": 310, "y": 1130, "w": 580, "h": 150, "fill": "surface_alt", "stroke": "teal"},
    {"id": "append", "label": "6 回写结果", "body": "追加进历史，进入下一轮", "x": 310, "y": 1360, "w": 580, "h": 150, "fill": "surface_alt", "stroke": "teal"}
  ],
  "edges": [
    {"id": "context-model", "from": "context", "to": "model", "from_port": "bottom", "to_port": "top"},
    {"id": "model-decision", "from": "model", "to": "decision", "from_port": "bottom", "to_port": "top"},
    {"id": "decision-done", "from": "decision", "to": "done", "from_port": "right", "to_port": "left", "label": "Task Done", "label_x": 930, "label_y": 825, "color": "coral"},
    {"id": "decision-validate", "from": "decision", "to": "validate", "from_port": "bottom", "to_port": "top", "label": "Tool Call", "label_x": 600, "label_y": 850, "color": "amber"},
    {"id": "validate-execute", "from": "validate", "to": "execute", "from_port": "bottom", "to_port": "top"},
    {"id": "execute-append", "from": "execute", "to": "append", "from_port": "bottom", "to_port": "top"},
    {"id": "append-context", "from": "append", "to": "context", "from_port": "left", "to_port": "left", "via": "left", "gutter": 110, "label": "下一轮", "label_x": 120, "label_y": 860, "accent": true}
  ]
}
