MAILDIR=$HOME/Mail
DEFAULT=$MAILDIR/inbox
VERBOSE=false
LOGFILE=/usr/local/var/log/procmail.log

:0:
* ^(From|Cc|To).*(mainliufeng@gmail\.com)
gmail

:0:
* ^(From|Cc|To).*(ai-alert@easemob\.com)
* ^(Subject).*(Error-Alert)
ai-alert

:0:
* ^(From|Cc|To).*(robot@easemob\.com)
* ^(Subject).*(Check)
easemob-robot-check

:0:
* ^(From|Cc|To).*(easemob\.com)
easemob

:0
* .*
inbox
