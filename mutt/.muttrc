set sendmail="/usr/local/bin/msmtp"
set hostname=localhost
set hidden_host
set editor="vim"
set record="~/Mail/sent-`date +%Y-%m`"
set use_from=yes
set from=mainliufeng@gmail.com
set realname="Liu Feng"
set envelope_from=yes
set ispell="/usr/local/bin/aspell"

macro generic "<esc>1" ":set from=mainliufeng@gmail.com"
macro generic "<esc>2" ":set from=liufeng@easemob.com"

set folder="~/Mail"
set mbox="~/Mail/inbox"
set spoolfile="~/Mail/inbox"
set postponed="~/Mail/postponed"
set alias_file="~/Mail/.aliases"

my_hdr From: mainliufeng@gmail.com
my_hdr Reply-To: mainliufeng@gmail.com
set index_format="| %4C | %Z | %{%b %d} | %-15.15L | %s" 
set folder_format="| %2C | %t %N | %8s | %d | %f" 
macro index G "!fetchmail -a -m 'procmail -d %T'\r"
macro pager G "!fetchmail -a -m 'procmail -d %T'\r"
set include
set indent_str="> "

set check_new=yes  # check for new mail
set mail_check=60
set timeout=30

auto_view text/html application/pdf application/msword
#alternative_order text/enriched text/plain text/html

source ~/dotfiles/mutt/color.muttrc
source ~/dotfiles/mutt/keybind.muttrc
source ~/dotfiles/mutt/sidebar.muttrc

mailboxes `echo ~/Mail/*`
