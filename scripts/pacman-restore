#!/bin/bash

# Arch Linux 包恢复脚本
# 从备份的包列表中恢复已安装的包

set -e  # 遇到错误立即退出

# 配置
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
PACMAN_DIR="$DOTFILES_DIR/pacman"
PKGLIST_FILE="$PACMAN_DIR/pkglist.txt"
FOREIGN_PKGLIST_FILE="$PACMAN_DIR/foreignpkglist.txt"
FAILED_PACKAGES_FILE="$PACMAN_DIR/failed_packages.txt"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 检查文件是否存在
if [[ ! -f "$PKGLIST_FILE" ]]; then
    echo -e "${RED}错误: 找不到包列表文件 $PKGLIST_FILE${NC}"
    echo "请先运行 pacman-backup 脚本创建备份"
    exit 1
fi

if [[ ! -f "$FOREIGN_PKGLIST_FILE" ]]; then
    echo -e "${RED}错误: 找不到 AUR 包列表文件 $FOREIGN_PKGLIST_FILE${NC}"
    echo "请先运行 pacman-backup 脚本创建备份"
    exit 1
fi

echo -e "${GREEN}Arch Linux 包恢复脚本${NC}"
echo "================================"
echo "官方包数量: $(wc -l < "$PKGLIST_FILE")"
echo "AUR 包数量: $(wc -l < "$FOREIGN_PKGLIST_FILE")"
echo ""

# 确认是否继续
read -p "是否继续恢复包？(y/N): " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "操作已取消"
    exit 0
fi

# 初始化失败包列表
> "$FAILED_PACKAGES_FILE"

# 更新系统包数据库
echo -e "${YELLOW}更新包数据库...${NC}"
sudo pacman -Sy

# 恢复官方包 - 逐个安装以处理错误
echo -e "${YELLOW}恢复官方包...${NC}"
echo "这可能需要一些时间，请耐心等待..."
echo ""

failed_official=0
total_official=$(wc -l < "$PKGLIST_FILE")
current=0

while IFS= read -r package; do
    current=$((current + 1))
    echo -ne "${BLUE}[$current/$total_official]${NC} 安装 $package... "
    
    if sudo pacman -S --needed --noconfirm "$package" >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC}"
    else
        echo -e "${RED}✗${NC}"
        echo "$package" >> "$FAILED_PACKAGES_FILE"
        failed_official=$((failed_official + 1))
    fi
done < "$PKGLIST_FILE"

echo ""
echo -e "${GREEN}官方包安装完成${NC}"
echo "成功: $((total_official - failed_official)) 个"
echo "失败: $failed_official 个"

# 检查是否需要安装 yay
if ! command -v yay &> /dev/null; then
    echo -e "${YELLOW}检测到没有安装 yay，正在安装...${NC}"
    sudo pacman -S --needed --noconfirm yay
fi

# 恢复 AUR 包 - 逐个安装以处理错误
echo -e "${YELLOW}恢复 AUR 包...${NC}"
echo "这可能需要更长时间，请耐心等待..."
echo ""

failed_aur=0
total_aur=$(wc -l < "$FOREIGN_PKGLIST_FILE")
current=0

while IFS= read -r package; do
    current=$((current + 1))
    echo -ne "${BLUE}[$current/$total_aur]${NC} 安装 $package... "
    
    if yay -S --needed --noconfirm "$package" >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC}"
    else
        echo -e "${RED}✗${NC}"
        echo "$package" >> "$FAILED_PACKAGES_FILE"
        failed_aur=$((failed_aur + 1))
    fi
done < "$FOREIGN_PKGLIST_FILE"

echo ""
echo -e "${GREEN}AUR 包安装完成${NC}"
echo "成功: $((total_aur - failed_aur)) 个"
echo "失败: $failed_aur 个"

# 显示失败统计
total_failed=$((failed_official + failed_aur))
if [[ $total_failed -gt 0 ]]; then
    echo ""
    echo -e "${YELLOW}⚠️  有 $total_failed 个包安装失败${NC}"
    echo "失败的包已记录到: $FAILED_PACKAGES_FILE"
    echo ""
    echo "失败的包列表："
    cat "$FAILED_PACKAGES_FILE"
    echo ""
    echo "建议手动处理这些包："
    echo "1. 检查包名是否正确"
    echo "2. 检查包是否已从仓库中移除"
    echo "3. 尝试手动安装或寻找替代包"
else
    echo ""
    echo -e "${GREEN}✓ 所有包恢复完成！${NC}"
fi

echo ""
echo "建议运行以下命令清理系统："
echo "  sudo pacman -Rns \$(pacman -Qtdq)  # 删除孤立包"
echo "  sudo pacman -Sc                   # 清理包缓存"
