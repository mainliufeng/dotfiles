#!/usr/bin/env python
import yaml
import sys
import re
from collections import defaultdict

def extract_country_code(node_name):
    """从节点名称提取国家代码"""
    name = node_name.upper()

    # 国旗表情符号 + 国家代码格式
    flag_pattern = r'[🇦-🇿]{2}([A-Z]{2})'
    match = re.search(flag_pattern, name)
    if match:
        return match.group(1)

    # 特殊符号 + 国家代码格式
    symbol_pattern = r'[►▶︎•·]([A-Z]{2})[| ]'
    match = re.search(symbol_pattern, name)
    if match:
        return match.group(1)

    # 国家名称关键词匹配
    country_keywords = {
        '香港': 'HK', 'HONGKONG': 'HK', 'HONG_KONG': 'HK',
        '台湾': 'TW', 'TAIWAN': 'TW', '台北': 'TW', 'TAIPEI': 'TW',
        '澳门': 'MO', 'MACAU': 'MO', 'MACAO': 'MO',
        '日本': 'JP', 'JAPAN': 'JP', '东京': 'JP', 'TOKYO': 'JP',
        '韩国': 'KR', 'KOREA': 'KR', '首尔': 'KR', 'SEOUL': 'KR', '仁川': 'KR', 'INCHEON': 'KR',
        '新加坡': 'SG', 'SINGAPORE': 'SG',
        '美国': 'US', 'USA': 'US', 'AMERICA': 'US', 'LOS_ANGELES': 'US', 'CHICAGO': 'US', 'NEW_YORK': 'US',
        '英国': 'UK', 'BRITAIN': 'UK', 'LONDON': 'UK',
        '德国': 'DE', 'GERMANY': 'DE', 'FRANKFURT': 'DE',
        '法国': 'FR', 'FRANCE': 'FR', 'PARIS': 'FR',
        '荷兰': 'NL', 'NETHERLANDS': 'NL', 'AMSTERDAM': 'NL',
        '加拿大': 'CA', 'CANADA': 'CA',
        '澳洲': 'AU', 'AUSTRALIA': 'AU', 'SYDNEY': 'AU',
        '印度': 'IN', 'INDIA': 'IN', 'MUMBAI': 'IN',
        '泰国': 'TH', 'THAILAND': 'TH', 'BANGKOK': 'TH',
        '马来西亚': 'MY', 'MALAYSIA': 'MY', 'KUALA_LUMPUR': 'MY',
        '菲律宾': 'PH', 'PHILIPPINES': 'PH', 'MANILA': 'PH',
        '越南': 'VN', 'VIETNAM': 'VN', 'HANOI': 'VN', 'HO_CHI_MINH': 'VN',
        '印尼': 'ID', 'INDONESIA': 'ID', 'JAKARTA': 'ID',
        '土耳其': 'TR', 'TURKEY': 'TR', 'ISTANBUL': 'TR'
    }

    name_upper = name.upper()
    for keyword, code in country_keywords.items():
        if keyword in name_upper:
            return code

    return 'OTHER'

def extract_source_name(file_path):
    """从文件路径提取来源名称"""
    import os
    basename = os.path.basename(file_path)
    # 从 clash.xxx.yaml 提取 xxx 作为来源名
    if basename.startswith('clash.') and basename.endswith('.yaml'):
        return basename[6:-5]  # 去掉 "clash." 和 ".yaml"
    return basename.replace('.yaml', '').replace('.yml', '')

def extract_nodes_from_file(file_path):
    """从配置文件中提取节点"""
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            config = yaml.safe_load(f)
            return config.get('proxies', [])
    except Exception as e:
        print(f"警告: 读取文件 {file_path} 失败: {e}", file=sys.stderr)
        return []

def merge_configs(input_files):
    """合并所有输入文件的节点，并记录来源"""
    all_nodes = []
    node_sources = {}  # 记录每个节点的来源
    seen_nodes = set()  # 用于去重 (name, server) 组合

    for file_path in input_files:
        source_name = extract_source_name(file_path)
        nodes = extract_nodes_from_file(file_path)
        for node in nodes:
            name = node.get('name', '')
            server = node.get('server', '')

            # 去重：名称+服务器地址组合判断重复
            node_key = (name, server)
            if node_key not in seen_nodes and name and server:
                seen_nodes.add(node_key)
                all_nodes.append(node)
                node_sources[name] = source_name  # 记录节点来源

    return all_nodes, node_sources

def generate_proxy_groups(nodes, node_sources):
    """生成多维度分组代理组 - 支持节点多分组归属和来源细分"""

    # 1. 按国家代码分类（每个国家一个分组）
    country_nodes = defaultdict(list)
    # 1.1 按国家+来源分类（每个国家的每个来源一个分组）
    country_source_nodes = defaultdict(lambda: defaultdict(list))
    # 2. 大洲分组
    special_groups = {
        '日韩新': [],     # 日本、韩国、新加坡（不含中国）
        'asia': [],       # 亚洲（不含中国）
        'europe': [],     # 欧洲
        'africa': [],     # 非洲
        'north_america': [],  # 北美洲
        'south_america': [],  # 南美洲
        'oceania': [],    # 大洋洲
        'all': []         # 全部
    }
    # 2.1 大洲分组按来源分类
    special_source_groups = defaultdict(lambda: defaultdict(list))

    # 只为这5个国家生成国家分组
    major_countries = {'CN', 'JP', 'KR', 'SG', 'US'}

    # 国家代码到中文名称的映射
    country_names = {
        'CN': '中国', 'HK': '中国香港', 'MO': '中国澳门', 'TW': '中国台湾',
        'JP': '日本', 'KR': '韩国', 'SG': '新加坡', 'MY': '马来西亚',
        'TH': '泰国', 'PH': '菲律宾', 'VN': '越南', 'ID': '印度尼西亚',
        'IN': '印度', 'US': '美国', 'CA': '加拿大', 'UK': '英国',
        'DE': '德国', 'FR': '法国', 'NL': '荷兰', 'IT': '意大利',
        'ES': '西班牙', 'AT': '奥地利', 'CH': '瑞士', 'BE': '比利时',
        'DK': '丹麦', 'SE': '瑞典', 'NO': '挪威', 'FI': '芬兰',
        'TR': '土耳其', 'AU': '澳大利亚', 'RU': '俄罗斯', 'MX': '墨西哥',
        'AE': '阿联酋', 'AR': '阿根廷', 'AZ': '阿塞拜疆', 'BD': '孟加拉国',
        'BG': '保加利亚', 'BIH': '波黑', 'BR': '巴西', 'CA': '加拿大',
        'CL': '智利', 'CY': '塞浦路斯', 'CZ': '捷克', 'EG': '埃及',
        'FI': '芬兰', 'FJ': '斐济', 'GF': '法属圭亚那', 'HU': '匈牙利',
        'ID': '印度尼西亚', 'IL': '以色列', 'IQ': '伊拉克', 'IT': '意大利',
        'JO': '约旦', 'KE': '肯尼亚', 'KHM': '柬埔寨', 'KZ': '哈萨克斯坦',
        'LG': '吉尔吉斯斯坦', 'LT': '立陶宛', 'LVA': '拉脱维亚', 'MD': '摩尔多瓦',
        'MK': '北马其顿', 'MM': '缅甸', 'MO': '中国澳门', 'MX': '墨西哥',
        'MY': '马来西亚', 'NG': '尼日利亚', 'NL': '荷兰', 'NO': '挪威',
        'NZ': '新西兰', 'PE': '秘鲁', 'PH': '菲律宾', 'PK': '巴基斯坦',
        'PL': '波兰', 'RO': '罗马尼亚', 'RS': '塞尔维亚', 'RU': '俄罗斯',
        'SE': '瑞典', 'SG': '新加坡', 'SI': '斯洛文尼亚', 'TH': '泰国',
        'TR': '土耳其', 'TW': '中国台湾', 'UA': '乌克兰', 'UK': '英国',
        'US': '美国', 'UY': '乌拉圭', 'VN': '越南', 'ZA': '南非'
    }

    all_node_names = []

    for node in nodes:
        name = node.get('name', '')
        server = node.get('server', '')
        if name and server:
            # 提取国家代码
            country_code = extract_country_code(name)
            source = node_sources.get(name, 'unknown')

            # 添加到国家分组 - 港澳台都归入中国
            if country_code in ['HK', 'MO', 'TW']:
                country_nodes['CN'].append(name)  # 港澳台都归中国
                country_source_nodes['CN'][source].append(name)  # 按来源细分
            else:
                country_nodes[country_code].append(name)
                country_source_nodes[country_code][source].append(name)  # 按来源细分
            all_node_names.append(name)

            # 添加到大洲分组
            # 日韩新分组（不含中国）
            if country_code in ['JP', 'KR', 'SG']:
                special_groups['日韩新'].append(name)
                special_source_groups['日韩新'][source].append(name)

            # 亚洲（不含中国港澳台）
            if country_code in ['JP', 'KR', 'SG', 'MY', 'TH', 'PH', 'VN', 'ID', 'IN', 'BD', 'PK', 'LK', 'MM', 'KHM', 'LA', 'BN', 'MN']:
                special_groups['asia'].append(name)
                special_source_groups['asia'][source].append(name)
            # 欧洲
            elif country_code in ['UK', 'DE', 'FR', 'NL', 'IT', 'ES', 'AT', 'CH', 'BE', 'DK', 'SE', 'NO', 'FI',
                                   'PL', 'RO', 'CZ', 'HU', 'BG', 'RS', 'HR', 'SI', 'SK', 'LT', 'LVA', 'EE',
                                   'IE', 'PT', 'GR', 'AL', 'MK', 'BA', 'MD', 'UA', 'BY', 'RU']:
                special_groups['europe'].append(name)
                special_source_groups['europe'][source].append(name)
            # 非洲
            elif country_code in ['ZA', 'EG', 'NG', 'KE', 'MA', 'TN', 'GH', 'ET', 'UG', 'TZ', 'DZ', 'SD',
                                   'AO', 'MZ', 'CM', 'CI', 'ZM', 'ZW', 'SN', 'ML', 'RW', 'SO', 'BF']:
                special_groups['africa'].append(name)
                special_source_groups['africa'][source].append(name)
            # 北美洲
            elif country_code in ['US', 'CA', 'MX', 'GT', 'HN', 'SV', 'NI', 'CR', 'PA', 'CU', 'DO', 'JM',
                                   'HT', 'BS', 'BB', 'TT', 'BZ']:
                special_groups['north_america'].append(name)
                special_source_groups['north_america'][source].append(name)
            # 南美洲
            elif country_code in ['BR', 'AR', 'CL', 'CO', 'PE', 'VE', 'EC', 'BO', 'PY', 'UY', 'GY', 'SR',
                                   'GF', 'FK']:
                special_groups['south_america'].append(name)
                special_source_groups['south_america'][source].append(name)
            # 大洋洲
            elif country_code in ['AU', 'NZ', 'FJ', 'PG', 'NC', 'PF', 'GU', 'AS', 'MP', 'WS', 'TO', 'VU',
                                   'SB', 'KI', 'FM', 'MH', 'PW', 'TV', 'NR']:
                special_groups['oceania'].append(name)
                special_source_groups['oceania'][source].append(name)

    # 构建代理组
    proxy_groups = []

    # 主选择组（默认选择中国，包含所有国家选项）
    # 构建国家分组列表（按节点数量排序，热门的放前面）
    country_proxy_list = []
    country_node_counts = {}

    # 统一的国旗映射（与后续代理组生成保持一致）
    flag_emoji_map = {
        'CN': '🇨🇳', 'JP': '🇯🇵', 'KR': '🇰🇷', 'SG': '🇸🇬', 'MY': '🇲🇾',
        'TH': '🇹🇭', 'PH': '🇵🇭', 'VN': '🇻🇳', 'ID': '🇮🇩', 'IN': '🇮🇳',
        'US': '🇺🇸', 'CA': '🇨🇦', 'UK': '🇬🇧', 'DE': '🇩🇪', 'FR': '🇫🇷',
        'NL': '🇳🇱', 'IT': '🇮🇹', 'ES': '🇪🇸', 'AT': '🇦🇹', 'CH': '🇨🇭',
        'BE': '🇧🇪', 'DK': '🇩🇰', 'SE': '🇸🇪', 'NO': '🇳🇴', 'FI': '🇫🇮',
        'TR': '🇹🇷', 'AU': '🇦🇺', 'RU': '🇷🇺', 'MX': '🇲🇽',
        'HK': '🇭🇰', 'TW': '🇹🇼'
    }

    # 记录每个国家实际生成的代理组名称
    country_proxy_names = {}  # country_code -> [实际生成的代理组名称列表]

    for country_code in sorted(country_nodes.keys()):
        if country_code != 'OTHER' and country_code not in ['HK', 'MO', 'TW']:  # 跳过港澳台
            nodes = country_nodes[country_code]
            if nodes:
                country_name = country_names.get(country_code, country_code)
                flag_emoji = flag_emoji_map.get(country_code, '🌍')
                country_node_counts[country_code] = len(nodes)

                # 根据来源数量决定实际生成的代理组名称
                source_groups = country_source_nodes.get(country_code, {})
                if len(source_groups) == 1:
                    # 单一来源
                    source_name = list(source_groups.keys())[0]
                    country_proxy_names[country_code] = [f'{flag_emoji} {country_name}-{source_name}']
                else:
                    # 多个来源
                    names = [f'{flag_emoji} {country_name}']
                    for source_name in sorted(source_groups.keys()):
                        names.append(f'{flag_emoji} {country_name}-{source_name}')
                    country_proxy_names[country_code] = names

    # 构建主选择组：5个主要国家 + 大洲分组 + 功能分组
    main_proxies = []

    # 添加5个主要国家及其所有代理组
    priority_country_codes = ['CN', 'JP', 'KR', 'SG', 'US']
    for country_code in priority_country_codes:
        if country_code in country_proxy_names:
            main_proxies.extend(country_proxy_names[country_code])

    # 添加大洲分组（根据来源数量决定名称）
    for region_key, region_name in [
        ('日韩新', '日韩新'),
        ('asia', '亚洲'),
        ('europe', '欧洲'),
        ('africa', '非洲'),
        ('north_america', '北美洲'),
        ('south_america', '南美洲'),
        ('oceania', '大洋洲')
    ]:
        if special_groups[region_key]:
            region_source_groups = special_source_groups.get(region_key, {})
            if len(region_source_groups) == 1:
                source_name = list(region_source_groups.keys())[0]
                main_proxies.append(f'{region_name}-{source_name}')
            else:
                main_proxies.append(region_name)
                for source_name in sorted(region_source_groups.keys()):
                    main_proxies.append(f'{region_name}-{source_name}')

    # 添加功能分组
    main_proxies.extend(['全部节点', '♻️ 自动选择', 'DIRECT'])

    proxy_groups.append({
        'name': '🚀 节点选择',
        'type': 'select',
        'proxies': main_proxies
    })

    # 1. 只为主要5国生成国家分组：中国、日本、韩国、新加坡、美国
    for country_code in sorted(country_nodes.keys()):
        nodes = country_nodes[country_code]
        if nodes and country_code != 'OTHER':
            # 跳过港澳台，这些地区都归到中国分组
            if country_code in ['HK', 'MO', 'TW']:
                continue

            # 只为主要国家生成分组
            if country_code not in major_countries:
                continue

            # 获取中文国家名称
            country_name = country_names.get(country_code, country_code)

            # 使用统一的国旗映射
            flag_emoji = flag_emoji_map.get(country_code, '🌍')

            # 国家总分组 - 根据来源数量决定命名和结构
            source_groups = country_source_nodes.get(country_code, {})

            if len(source_groups) == 1:
                # 单一来源：直接命名为 "🇨🇳 中国-bywave"
                source_name = list(source_groups.keys())[0]
                proxy_groups.append({
                    'name': f'{flag_emoji} {country_name}-{source_name}',
                    'type': 'url-test',
                    'url': 'http://www.gstatic.com/generate_204',
                    'interval': 300,
                    'tolerance': 50,
                    'proxies': nodes
                })
            else:
                # 多个来源：创建总分组 + 子分组
                country_proxies = []

                # 先添加来源子分组的引用
                for source_name in sorted(source_groups.keys()):
                    country_proxies.append(f'{flag_emoji} {country_name}-{source_name}')

                # 添加所有节点
                country_proxies.extend(nodes)

                # 创建国家总分组
                proxy_groups.append({
                    'name': f'{flag_emoji} {country_name}',
                    'type': 'url-test',
                    'url': 'http://www.gstatic.com/generate_204',
                    'interval': 300,
                    'tolerance': 50,
                    'proxies': country_proxies
                })

                # 创建来源子分组
                for source_name in sorted(source_groups.keys()):
                    source_nodes = source_groups[source_name]
                    if source_nodes:
                        proxy_groups.append({
                            'name': f'{flag_emoji} {country_name}-{source_name}',
                            'type': 'url-test',
                            'url': 'http://www.gstatic.com/generate_204',
                            'interval': 300,
                            'tolerance': 50,
                            'proxies': source_nodes
                        })

    # 2. 大洲分组（支持按来源细分）
    region_name_map = {
        '日韩新': '日韩新',
        'asia': '亚洲',
        'europe': '欧洲',
        'africa': '非洲',
        'north_america': '北美洲',
        'south_america': '南美洲',
        'oceania': '大洋洲'
    }

    for region_key, region_name in [
        ('日韩新', '日韩新'),
        ('asia', '亚洲'),
        ('europe', '欧洲'),
        ('africa', '非洲'),
        ('north_america', '北美洲'),
        ('south_america', '南美洲'),
        ('oceania', '大洋洲')
    ]:
        if special_groups[region_key]:
            region_source_groups = special_source_groups.get(region_key, {})

            if len(region_source_groups) == 1:
                # 单一来源：直接命名
                source_name = list(region_source_groups.keys())[0]
                proxy_groups.append({
                    'name': f'{region_name}-{source_name}',
                    'type': 'url-test',
                    'url': 'http://www.gstatic.com/generate_204',
                    'interval': 300,
                    'tolerance': 50,
                    'proxies': special_groups[region_key]
                })
            else:
                # 多个来源：创建总分组 + 子分组
                region_proxies = []

                # 先添加来源子分组的引用
                for source_name in sorted(region_source_groups.keys()):
                    region_proxies.append(f'{region_name}-{source_name}')

                # 添加所有节点
                region_proxies.extend(special_groups[region_key])

                # 创建地区总分组
                proxy_groups.append({
                    'name': region_name,
                    'type': 'url-test',
                    'url': 'http://www.gstatic.com/generate_204',
                    'interval': 300,
                    'tolerance': 50,
                    'proxies': region_proxies
                })

                # 创建来源子分组
                for source_name in sorted(region_source_groups.keys()):
                    source_nodes = region_source_groups[source_name]
                    if source_nodes:
                        proxy_groups.append({
                            'name': f'{region_name}-{source_name}',
                            'type': 'url-test',
                            'url': 'http://www.gstatic.com/generate_204',
                            'interval': 300,
                            'tolerance': 50,
                            'proxies': source_nodes
                        })

    # 4. 全部节点组
    if all_node_names:
        proxy_groups.append({
            'name': '全部节点',
            'type': 'url-test',
            'url': 'http://www.gstatic.com/generate_204',
            'interval': 300,
            'tolerance': 50,
            'proxies': all_node_names
        })

    # 5. 自动选择组
    if all_node_names:
        proxy_groups.append({
            'name': '♻️ 自动选择',
            'type': 'url-test',
            'url': 'http://www.gstatic.com/generate_204',
            'interval': 300,
            'tolerance': 50,
            'proxies': all_node_names
        })

    # 应用专用组（更新为包含5个主要国家+大洲分组的结构）
    # 构建国家分组引用列表（只包含5个主要国家）
    country_refs = []
    for country_code in ['CN', 'JP', 'KR', 'SG', 'US']:
        if country_code in country_proxy_names:
            # 只添加主代理组名称（总分组或单一来源名）
            country_refs.append(country_proxy_names[country_code][0])

    # 添加大洲分组（根据实际生成的名称）
    region_refs = []
    for region_key, region_name in [
        ('日韩新', '日韩新'),
        ('asia', '亚洲'),
        ('europe', '欧洲'),
        ('africa', '非洲'),
        ('north_america', '北美洲'),
        ('south_america', '南美洲'),
        ('oceania', '大洋洲')
    ]:
        if special_groups[region_key]:
            region_source_groups = special_source_groups.get(region_key, {})
            if len(region_source_groups) == 1:
                source_name = list(region_source_groups.keys())[0]
                region_refs.append(f'{region_name}-{source_name}')
            else:
                region_refs.append(region_name)

    # 获取特定国家的实际代理组名
    def get_country_name(code):
        return country_proxy_names.get(code, [])[0] if code in country_proxy_names else None

    us_name = get_country_name('US')
    cn_name = get_country_name('CN')
    jp_name = get_country_name('JP')
    kr_name = get_country_name('KR')
    sg_name = get_country_name('SG')

    # 构建Netflix/OpenAI优先列表（美国优先）
    netflix_openai_priority = ['🚀 节点选择']
    if us_name:
        netflix_openai_priority.append(us_name)

    # 构建游戏平台/国内网站优先列表（直连优先，中日韩次之）
    game_domestic_priority = ['DIRECT', '🚀 节点选择']
    if cn_name:
        game_domestic_priority.append(cn_name)
    if jp_name:
        game_domestic_priority.append(jp_name)
    if kr_name:
        game_domestic_priority.append(kr_name)

    app_groups = [
        {'name': '🔎 Google', 'type': 'select', 'proxies': ['🚀 节点选择'] + country_refs + region_refs + ['♻️ 自动选择', 'DIRECT']},
