#!/bin/bash

# Arch Linux 失败包修复脚本
# 处理 pacman-restore 脚本中安装失败的包

set -e

# 配置
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
PACMAN_DIR="$DOTFILES_DIR/pacman"
FAILED_PACKAGES_FILE="$PACMAN_DIR/failed_packages.txt"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 检查失败包文件是否存在
if [[ ! -f "$FAILED_PACKAGES_FILE" ]]; then
    echo -e "${YELLOW}没有找到失败包列表文件${NC}"
    echo "请先运行 pacman-restore 脚本"
    exit 0
fi

# 检查是否有失败的包
if [[ ! -s "$FAILED_PACKAGES_FILE" ]]; then
    echo -e "${GREEN}没有失败的包需要处理${NC}"
    exit 0
fi

echo -e "${GREEN}失败包修复脚本${NC}"
echo "=================="
echo ""

failed_count=$(wc -l < "$FAILED_PACKAGES_FILE")
echo "发现 $failed_count 个失败的包："
echo ""

# 显示失败的包
while IFS= read -r package; do
    echo -e "${RED}• $package${NC}"
done < "$FAILED_PACKAGES_FILE"

echo ""
echo "处理选项："
echo "1. 尝试重新安装所有失败的包"
echo "2. 逐个处理失败的包"
echo "3. 检查包的状态和可用性"
echo "4. 退出"

read -p "请选择操作 (1-4): " choice

case $choice in
    1)
        echo ""
        echo -e "${YELLOW}尝试重新安装所有失败的包...${NC}"
        while IFS= read -r package; do
            echo -e "${BLUE}尝试安装: $package${NC}"
            
            # 尝试从官方仓库安装
            if sudo pacman -S --needed --noconfirm "$package" 2>/dev/null; then
                echo -e "${GREEN}✓ 成功从官方仓库安装: $package${NC}"
            # 尝试从 AUR 安装
            elif yay -S --needed --noconfirm "$package" 2>/dev/null; then
                echo -e "${GREEN}✓ 成功从 AUR 安装: $package${NC}"
            else
                echo -e "${RED}✗ 仍然无法安装: $package${NC}"
                echo "可能的原因："
                echo "  - 包名可能已更改"
                echo "  - 包可能已从仓库中移除"
                echo "  - 可能需要手动编译安装"
            fi
            echo ""
        done < "$FAILED_PACKAGES_FILE"
        ;;
    2)
        echo ""
        echo -e "${YELLOW}逐个处理失败的包...${NC}"
        while IFS= read -r package; do
            echo ""
            echo -e "${BLUE}处理包: $package${NC}"
            echo "选项："
            echo "  1. 尝试从官方仓库安装"
            echo "  2. 尝试从 AUR 安装"
            echo "  3. 搜索包信息"
            echo "  4. 跳过此包"
            
            read -p "请选择操作 (1-4): " pkg_choice
            
            case $pkg_choice in
                1)
                    echo "尝试从官方仓库安装..."
                    if sudo pacman -S --needed --noconfirm "$package"; then
                        echo -e "${GREEN}✓ 成功安装: $package${NC}"
                    else
                        echo -e "${RED}✗ 安装失败: $package${NC}"
                    fi
                    ;;
                2)
                    echo "尝试从 AUR 安装..."
                    if yay -S --needed --noconfirm "$package"; then
                        echo -e "${GREEN}✓ 成功安装: $package${NC}"
                    else
                        echo -e "${RED}✗ 安装失败: $package${NC}"
                    fi
                    ;;
                3)
                    echo "搜索包信息..."
                    echo "官方仓库搜索结果："
                    pacman -Ss "$package" | head -10
                    echo ""
                    echo "AUR 搜索结果："
                    yay -Ss "$package" | head -10
                    ;;
                4)
                    echo "跳过此包"
                    ;;
                *)
                    echo "无效选择，跳过此包"
                    ;;
            esac
        done < "$FAILED_PACKAGES_FILE"
        ;;
    3)
        echo ""
        echo -e "${YELLOW}检查包的状态和可用性...${NC}"
        while IFS= read -r package; do
            echo ""
            echo -e "${BLUE}检查包: $package${NC}"
            
            # 检查是否已安装
            if pacman -Q "$package" >/dev/null 2>&1; then
                echo -e "${GREEN}✓ 包已安装${NC}"
                continue
            fi
            
            # 检查官方仓库
            if pacman -Ss "^$package$" >/dev/null 2>&1; then
                echo -e "${GREEN}✓ 在官方仓库中找到${NC}"
            else
                echo -e "${RED}✗ 在官方仓库中未找到${NC}"
            fi
            
            # 检查 AUR
            if yay -Ss "^$package$" >/dev/null 2>&1; then
                echo -e "${GREEN}✓ 在 AUR 中找到${NC}"
            else
                echo -e "${RED}✗ 在 AUR 中未找到${NC}"
            fi
            
            # 搜索相似包名
            echo "相似包名搜索："
            pacman -Ss "$package" | head -5
            yay -Ss "$package" | head -5
        done < "$FAILED_PACKAGES_FILE"
        ;;
    4)
        echo "退出"
        exit 0
        ;;
    *)
        echo "无效选择"
        exit 1
        ;;
esac

echo ""
echo -e "${GREEN}处理完成！${NC}" 