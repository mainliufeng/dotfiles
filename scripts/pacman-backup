#!/bin/bash

# Arch Linux 包备份脚本
# 备份所有已安装的包列表，用于系统重装后快速恢复

set -e  # 遇到错误立即退出

# 配置
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
PACMAN_DIR="$DOTFILES_DIR/pacman"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

# 创建备份目录
mkdir -p "$PACMAN_DIR"

echo "开始备份包列表..."

# 备份官方仓库包
echo "备份官方仓库包..."
if pacman -Qqe > "$PACMAN_DIR/pkglist.txt"; then
    echo "✓ 官方包列表已备份到: $PACMAN_DIR/pkglist.txt"
    echo "  包含 $(wc -l < "$PACMAN_DIR/pkglist.txt") 个包"
else
    echo "✗ 备份官方包列表失败"
    exit 1
fi

# 备份 AUR 包
echo "备份 AUR 包..."
if pacman -Qqm > "$PACMAN_DIR/foreignpkglist.txt"; then
    echo "✓ AUR 包列表已备份到: $PACMAN_DIR/foreignpkglist.txt"
    echo "  包含 $(wc -l < "$PACMAN_DIR/foreignpkglist.txt") 个包"
else
    echo "✗ 备份 AUR 包列表失败"
    exit 1
fi

# 创建带时间戳的备份
cp "$PACMAN_DIR/pkglist.txt" "$PACMAN_DIR/pkglist_$TIMESTAMP.txt"
cp "$PACMAN_DIR/foreignpkglist.txt" "$PACMAN_DIR/foreignpkglist_$TIMESTAMP.txt"

echo "✓ 备份完成！"
echo "  时间戳备份: $TIMESTAMP"
echo ""
echo "恢复命令:"
echo "  sudo pacman -S --needed - < $PACMAN_DIR/pkglist.txt"
echo "  yay -S --needed - < $PACMAN_DIR/foreignpkglist.txt"
