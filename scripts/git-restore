#!/bin/sh
#
# Restore a single git repository from bundle files.
#
# Usage: git-restore <repo_name> [<backup_dir>]
#
REPO=$1
BACKUP_DIR=${2:-"$HOME/dotfiles/git_backup"}

if [ $# -lt 1 ]; then
  echo "Usage: $(basename "$0") <repo_name> [<backup_dir>]" >&2
  exit 1
fi

rc=1

for file in ${BACKUP_DIR}/${REPO}.bundle; do
  bundleFile="$file"
  repoName=$(basename "${bundleFile}" | cut -d'.' -f1)

  git clone "${bundleFile}" -o bundle
  cd "${repoName}" || exit 1
  git remote add origin "git@github.com:mainliufeng/${repoName}.git" || true

  # Optional upstream remote (set as needed)
  # git remote add upstream git@github.com:<org>/${repoName}.git

  cd ..
  rc=$?
done

if [ ${rc} -eq 0 ]; then
  echo "INFO: repository ${REPO} restored successfully"
else
  echo "ERROR: restoring failed: ${rc}" >&2
  exit ${rc}
fi
