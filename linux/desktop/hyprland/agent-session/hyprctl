#!/usr/bin/python3
"""Keep the existing human scripts working inside the Lua fork session."""
import json
import os
import subprocess
import sys
from compat import dispatch, lua, value

args=sys.argv[1:]
target=[]
for flag in ('--instance', '-i'):
    if flag in args:
        index=args.index(flag)
        if index+1<len(args): target=[flag,args[index+1]]
try:
    caps=subprocess.run(['/usr/bin/hyprctl',*target,'-j','seat','capabilities'],capture_output=True,text=True,timeout=3)
    modern=caps.returncode==0 and json.loads(caps.stdout).get('dialect')=='lua'
except (ValueError,subprocess.SubprocessError): modern=False
if not modern: os.execv('/usr/bin/hyprctl',['hyprctl',*args])

def translate(command):
    pieces=command.split(None,2)
    if pieces[0]=='dispatch' and len(pieces)>1 and not pieces[1].startswith('hl.'):
        return 'dispatch '+dispatch(pieces[1],pieces[2] if len(pieces)>2 else '')
    if pieces[0]=='keyword' and len(pieces)==3:
        return 'eval hl.config('+lua({pieces[1].replace(':','.'):value(pieces[2])})+')'
    return command

try:
    if '--batch' in args:
        index=args.index('--batch')+1
        args[index]=';'.join(translate(c.strip()) for c in args[index].split(';') if c.strip())
    elif 'dispatch' in args:
        index=args.index('dispatch')
        expression=translate(' '.join(args[index:]))
        args=args[:index]+['dispatch',expression.removeprefix('dispatch ')]
    elif 'keyword' in args:
        index=args.index('keyword'); expression=translate(' '.join(args[index:]))
        args=args[:index]+['eval',expression.removeprefix('eval ')]
    os.execv('/usr/bin/hyprctl',['hyprctl',*args])
except ValueError as error:
    print('hyprctl compatibility: '+str(error),file=sys.stderr);sys.exit(1)
