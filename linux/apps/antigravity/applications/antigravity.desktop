[Desktop Entry]
Type=Application
Name=Antigravity
GenericName=Code Editor
Comment=Agentic development platform
Exec=/bin/sh -c 'extra=""; if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then export ELECTRON_ENABLE_WAYLAND=1; extra="--ozone-platform=wayland --enable-features=WaylandWindowDecorations"; if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || case "${XDG_CURRENT_DESKTOP:-}" in *Hyprland*|*hyprland*) true;; *) false;; esac; then export ELECTRON_FORCE_DEVICE_SCALE_FACTOR=1; extra="$extra --force-device-scale-factor=1"; fi; fi; exec /usr/bin/antigravity $extra "$@"' sh %F
TryExec=/usr/bin/antigravity
Icon=antigravity
Terminal=false
Categories=Development;IDE;TextEditor;
Keywords=vscode;ide;editor;
StartupNotify=true
StartupWMClass=Antigravity
MimeType=application/x-antigravity-workspace;
Actions=new-empty-window;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/bin/sh -c 'extra=""; if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then export ELECTRON_ENABLE_WAYLAND=1; extra="--ozone-platform=wayland --enable-features=WaylandWindowDecorations"; if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || case "${XDG_CURRENT_DESKTOP:-}" in *Hyprland*|*hyprland*) true;; *) false;; esac; then export ELECTRON_FORCE_DEVICE_SCALE_FACTOR=1; extra="$extra --force-device-scale-factor=1"; fi; fi; exec /usr/bin/antigravity $extra "$@"' sh --new-window %F
Icon=antigravity
