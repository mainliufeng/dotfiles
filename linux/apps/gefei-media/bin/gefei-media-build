APP_JS = """
const q=document.getElementById('q');
const items=[...document.querySelectorAll('li.item')];
const secs=[...document.querySelectorAll('details')];
function apply(){
  const k=q.value.trim().toLowerCase();
  items.forEach(i=>{i.style.display=!k||i.dataset.k.includes(k)?'':'none'});
  secs.forEach(s=>{
    const vis=[...s.querySelectorAll('li.item')].some(i=>i.style.display!=='none');
    s.style.display=vis?'':'none';
    if(k&&vis)s.open=true;
  });
}
q.addEventListener('input',apply);
const player=document.querySelector('.player'),vid=player.querySelector('video'),pt=player.querySelector('.ptitle span');
document.querySelectorAll('button[data-src]').forEach(b=>b.addEventListener('click',()=>{
  vid.src=b.dataset.src; vid.play().catch(()=>{});
  pt.textContent=b.dataset.title;
  player.classList.add('on');
  player.scrollIntoView({behavior:'smooth',block:'start'});
}));
if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js').catch(()=>{});}
"""


def build_index(web: str, groups, docs, counts) -> None:
    parts = []
    for section, vids in groups:
        rows = []
        for v in vids:
            k = html.escape((v["rel"] + " " + section).lower(), quote=True)
            thumb = (f'<img class=th src="{v["thumb"]}" alt="" loading=lazy>'
                     if v.get("thumb") else '<img class=th alt="">')
            rows.append(
                f'<li class=item data-k="{k}">{thumb}<div class=meta>'
                f'<div class=t>{html.escape(v["title"])}</div>'
                f'<div class=s>{fmt_dur(v["duration"])} · {human(v["size"])}'
                f' · <a href="{v["href"]}" target=_blank rel=noopener>新窗口</a></div>'
                f'</div><button data-src="{v["href"]}" data-title="{html.escape(v["title"], quote=True)}">播放</button></li>')
        total = sum(v["size"] for v in vids)
        parts.append(f'<details open><summary>{html.escape(section)} '
                     f'<span class=count>· {len(vids)} 个 · {human(total)}</span></summary>'
                     f'<ul>{"".join(rows)}</ul></details>')

    doc_rows = []
    for d in docs:
        tag = {"pdf": "PDF", "html": "网页版", "download": "下载"}[d["kind"]]
        extra = "" if d["kind"] != "download" else "（浏览器无法直接预览，点开下载）"
        doc_rows.append(f'<a href="{d["href"]}" target=_blank rel=noopener>{html.escape(d["name"])}'
                        f'<span>{tag} · {human(d["size"])}{extra}</span></a>')
    docs_html = (f'<details><summary>文档 <span class=count>· {len(docs)} 个</span></summary>'
                 f'<div class=grid>{"".join(doc_rows)}</div></details>') if docs else ""

    others = []
    for label, n, size, href in counts:
        if n:
            others.append(f'<a href="{href}" target=_blank rel=noopener>{label}'
                          f'<span>{n} 个 · {human(size)}</span></a>')
    others_html = (f'<details><summary>其他素材 <span class=count>· 图片 / 文本 / 音频</span></summary>'
                   f'<div class=grid>{"".join(others)}</div></details>') if others else ""

    page = f"""<!doctype html><html lang=zh><head>
<meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name=theme-color content="#161618">
<meta name=apple-mobile-web-app-capable content="yes">
<meta name=apple-mobile-web-app-status-bar-style content="black-translucent">
<title>{APP_NAME}</title>
<link rel=manifest href="manifest.webmanifest">
<link rel=apple-touch-icon href="icon.png">
<link rel=stylesheet href="style.css">
</head><body>
<header>
  <h1>{APP_NAME}</h1>
  <div class=stats>{stats_line}</div>
  <input id=q type=search placeholder="搜索讲者 / 主题 / 场次…" autocomplete=off>
</header>
<div class=player><video controls playsinline preload=none></video>
  <div class=ptitle>正在播放：<span></span></div></div>
{"".join(parts)}
{docs_html}
{others_html}
<footer>数据在电脑本机 <code>{MEDIA_ROOT}</code>，经 Tailscale 只在你自己的设备间传输。<br>
第一次打开后可用浏览器“添加到主屏幕 / 安装应用”。</footer>
<script src="app.js"></script>
</body></html>"""
    with open(os.path.join(web, "index.html"), "w", encoding="utf-8") as fh:
        fh.write(page)
    return page


def make_manifest() -> dict:
    return {
    "name": APP_NAME,
    "short_name": APP_SHORT,
    "description": "哥飞社群线下分享 / 直播回放视频与文档，走 Tailscale 在手机上直接看",
    "start_url": ".",
    "scope": ".",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#161618",
    "theme_color": "#161618",
    "icons": [{"src": "icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
              {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
              {"src": "icon.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}],
    }

SW = """// 只为满足可安装性；不缓存媒体（视频走 Range，缓存反而坏事）
self.addEventListener("install", () => self.skipWaiting());
self.addEventListener("activate", (e) => e.waitUntil(self.clients.claim()));
self.addEventListener("fetch", () => {});
"""


def main() -> int:
    global MEDIA_ROOT, APP_NAME, APP_SHORT, stats_line
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=CONF["root"])
    ap.add_argument("--out", default="")
    ap.add_argument("--no-thumbs", action="store_true")
    args = ap.parse_args()
    MEDIA_ROOT = os.path.abspath(os.path.expanduser(args.root))
    APP_NAME, APP_SHORT = CONF["app_name"], CONF["app_short"]
    web = os.path.abspath(os.path.expanduser(args.out)) if args.out else os.path.join(MEDIA_ROOT, ".web")
    os.makedirs(os.path.join(web, "thumbs"), exist_ok=True)
    # 文档视图每次都重新生成：转换规则（限幅）会变，且量小
    shutil.rmtree(os.path.join(web, "docs"), ignore_errors=True)
    os.makedirs(os.path.join(web, "docs"), exist_ok=True)

    cache_path = os.path.join(web, "cache.json")
    cache = {}
    if os.path.exists(cache_path):
        try:
            cache = json.load(open(cache_path, encoding="utf-8"))
        except Exception:  # noqa: BLE001
            cache = {}

    # ---- media symlinks so the served root also exposes the payload
    for name in ("视频", "文档", "图片", "文本", "音频", "代码"):
        src = os.path.join(MEDIA_ROOT, name)
        link = os.path.join(web, "media", name)
        if os.path.isdir(src):
            os.makedirs(os.path.join(web, "media"), exist_ok=True)
            if os.path.islink(link) or os.path.exists(link):
                if os.path.islink(link):
                    os.unlink(link)
                else:
                    continue
            os.symlink(os.path.relpath(src, os.path.dirname(link)), link)

    # ---- videos
    vroot = os.path.join(MEDIA_ROOT, "视频")
    groups: dict[str, list] = {}
    seen_names = set()
    all_videos = []
    for dirpath, dirnames, files in os.walk(vroot):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for fn in sorted(files):
            ext = os.path.splitext(fn)[1].lower()
            if ext not in VIDEO_EXT:
                continue
            full = os.path.join(dirpath, fn)
            # .ts 与 .mp4 同名视为同一份内容，只收 mp4
            stem = os.path.splitext(fn)[0]
            if os.path.exists(os.path.join(dirpath, stem + ".ts")) and ext != ".mp4":
                continue
            rel = os.path.relpath(full, MEDIA_ROOT)
            section = os.path.relpath(dirpath, vroot)
            if section == ".":
                section = "其他 / 单集"
            title = re.sub(r"\s*-\s*Web\.Cafe(_\d+)?$", "", stem)
            if section.split("/")[0] == "群聊小视频":
                inside = section.split("/")[1:]
                origin = inside[0] if inside else "群聊"
                when = inside[-1] if len(inside) > 1 and re.match(r"^\d{4}-\d{2}$", inside[-1]) else ""
                section = "群聊小视频（群里转发的）"
                title = f"{origin} {'/'.join(inside[1:])} {title}".strip()
                if when:
                    title = title.replace(" ", " ", 1)
            key = f"vid::{rel}"
            st = os.stat(full)
            sig = f"{st.st_size}:{int(st.st_mtime)}"
            c = cache.get(key)
            dur = c["duration"] if c and c.get("sig") == sig and c.get("duration") else probe_duration(full)
            tid = base64.urlsafe_b64encode(rel.encode()).decode().strip("=")[-64:]
            thumb_rel = f"thumbs/{tid}.jpg"
            thumb_ok = False
            if not args.no_thumbs and (not c or c.get("sig") != sig or not os.path.exists(os.path.join(web, thumb_rel))):
                thumb_ok = make_thumb(full, os.path.join(web, thumb_rel), dur)
            elif os.path.exists(os.path.join(web, thumb_rel)):
                thumb_ok = True
            cache[key] = {"sig": sig, "duration": dur, "thumb": thumb_rel if thumb_ok else ""}
            item = {"rel": rel, "title": title, "duration": dur, "size": st.st_size,
                    "href": "media/" + quote_path(rel),
                    "thumb": thumb_rel if thumb_ok else ""}
            groups.setdefault(section, []).append(item)
            all_videos.append(item)
            seen_names.add(fn)

    # ---- documents
    docs = []
    droot = os.path.join(MEDIA_ROOT, "文档")
    if os.path.isdir(droot):
        for dirpath, dirnames, files in os.walk(droot):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            for fn in sorted(files):
                ext = os.path.splitext(fn)[1].lower()
                if ext not in DOC_EXT:
                    continue
                full = os.path.join(dirpath, fn)
                res = convert_doc(full, web, cache)
                docs.append({"name": fn, "size": os.path.getsize(full), **res})

    # ---- other material (counts only, files are browsable via /media/)
    others = []
    for label, sub, exts in (("图片", "图片", IMG_EXT), ("文本", "文本", {".json", ".html", ".htm", ".md"}),
                             ("音频", "音频", AUDIO_EXT), ("代码", "代码", {".zip"})):
        d = os.path.join(MEDIA_ROOT, sub)
        n = 0
        total = 0
        for dirpath, _dn, files in os.walk(d):
            for fn in files:
                if os.path.splitext(fn)[1].lower() in exts:
                    try:
                        total += os.path.getsize(os.path.join(dirpath, fn))
                    except OSError:
                        pass
                    n += 1
        if n:
            others.append((label, n, total, f"media/{quote_path(sub)}/"))

    vsize = sum(v["size"] for v in all_videos)
    vdur = sum(v["duration"] for v in all_videos)
    stats_line = (f"{len(all_videos)} 个视频 · {human(vsize)} · 约 {vdur/3600:.0f} 小时"
                  f" · 文档 {len(docs)} · 更新 {__import__('time').strftime('%Y-%m-%d %H:%M')}")

    build_index(web, sorted(groups.items(), key=lambda kv: (-len(kv[1]), kv[0])), docs, others)

    with open(os.path.join(web, "style.css"), "w", encoding="utf-8") as fh:
        fh.write(STYLE)
    with open(os.path.join(web, "app.js"), "w", encoding="utf-8") as fh:
        fh.write(APP_JS)
    with open(os.path.join(web, "manifest.webmanifest"), "w", encoding="utf-8") as fh:
        json.dump(make_manifest(), fh, ensure_ascii=False, indent=2)
    with open(os.path.join(web, "sw.js"), "w", encoding="utf-8") as fh:
        fh.write(SW)
    icon_src = os.path.join(ASSETS, "icon.png")
    if os.path.exists(icon_src):
        shutil.copy2(icon_src, os.path.join(web, "icon.png"))
        try:
            from PIL import Image
            Image.open(icon_src).resize((192, 192)).save(os.path.join(web, "icon-192.png"))
        except Exception:  # noqa: BLE001
            pass
    # 404 → 列表页（PWA 里点错路径不至于白屏）
    shutil.copy2(os.path.join(web, "index.html"), os.path.join(web, "404.html"))

    with open(cache_path, "w", encoding="utf-8") as fh:
        json.dump(cache, fh, ensure_ascii=False)

    log(f"站点已生成: {web}")
    log(f"  {len(all_videos)} 个视频 / {len(groups)} 个场次 / {len(docs)} 个文档 / {human(vsize)}")
    for s, v in sorted(groups.items(), key=lambda kv: -len(kv[1])):
        log(f"   - {s}: {len(v)} 个")
    return 0


def load_conf() -> dict:
    conf_file = os.environ.get("GEFEI_MEDIA_CONF", os.path.join(HERE, "..", "sites.conf"))
    conf = {"root": "~/Documents/gefei-share", "port": "8097", "base_path": "/gefei-media",
            "app_name": "哥飞 · 分享视频", "app_short": "分享视频", "bind": "127.0.0.1"}
    if os.path.exists(conf_file):
        for line in open(conf_file, encoding="utf-8"):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("|")
            if len(parts) >= 6:
                conf.update({"root": parts[1], "port": parts[2], "base_path": parts[3],
                             "app_name": parts[4], "app_short": parts[5]})
    root = conf["root"]
    if not root.startswith(("/", "~")):   # sites.conf 写的是相对 $HOME 的路径
        root = os.path.join("~", root)
    conf["root"] = os.path.expanduser(root)
    return conf


CONF = load_conf()
MEDIA_ROOT = CONF["root"]
APP_NAME = CONF["app_name"]
APP_SHORT = CONF["app_short"]
stats_line = ""

if __name__ == "__main__":
    sys.exit(main())
