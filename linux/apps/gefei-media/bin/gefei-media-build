#!/usr/bin/env python3
"""Build the phone-friendly media site for a local share dump.

    gefei-media-build [--root DIR] [--out DIR]

Turns a media tree like

    ~/Documents/gefei-share/
    ├── 视频/场次A/x.mp4          (mp4 preferred, ts fallback)
    ├── 文档/**.{pdf,docx,xlsx,pptx,txt}
    ├── 图片/**.{png,jpg}
    ├── 文本/**.{json,html}
    └── 音频/**.mp3

into a PWA-ready static site at `<root>/.web/` that a plain static server can
host behind Tailscale: one entry page with a sticky player, client-side search,
`<details>` sections, thumbnails, plus server-side-free document viewers
(PDF shown inline by the browser, docx via pandoc, xlsx/pptx rendered from the
OOXML zip by this script).

Everything is cached by (path, size, mtime) in `.web/cache.json`, so rebuilds
only pay for what changed.
"""
from __future__ import annotations

import argparse
import base64
import html
import json
import os
import re
import shutil
import subprocess
import sys
import zipfile
from xml.etree import ElementTree as ET

HERE = os.path.dirname(os.path.realpath(__file__))
ASSETS = os.path.join(HERE, "..", "assets")
VIDEO_EXT = {".mp4", ".m4v", ".webm", ".mov", ".mkv"}
DOC_EXT = {".pdf", ".docx", ".xlsx", ".pptx", ".txt", ".csv"}
IMG_EXT = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg"}
AUDIO_EXT = {".mp3", ".m4a", ".wav", ".aac", ".flac"}
SKIP_DIRS = {".web", "原始压缩包"}


def log(*a):
    print(*a, file=sys.stderr, flush=True)


def human(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024.0
    return f"{n:.1f} TB"


def fmt_dur(seconds: float) -> str:
    s = int(round(seconds))
    h, rem = divmod(s, 3600)
    m, sec = divmod(rem, 60)
    return f"{h}:{m:02d}:{sec:02d}" if h else f"{m}:{sec:02d}"


# ---------------------------------------------------------------- ffprobe/ffmpeg
def probe_duration(path: str) -> float:
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", path],
            capture_output=True, text=True, timeout=60).stdout.strip()
        return float(out) if out else 0.0
    except Exception:  # noqa: BLE001
        return 0.0


def make_thumb(path: str, dest: str, duration: float) -> bool:
    if os.path.exists(dest) and os.path.getsize(dest) > 0:
        return True
    at = 60.0 if duration <= 0 else min(max(duration * 0.15, 5.0), 600.0)
    cmd = ["ffmpeg", "-v", "error", "-y", "-ss", f"{at:.1f}", "-i", path,
           "-frames:v", "1", "-vf", "scale=480:-2", "-q:v", "6", dest]
    try:
        return subprocess.run(cmd, capture_output=True, timeout=180).returncode == 0 \
            and os.path.exists(dest) and os.path.getsize(dest) > 0
    except Exception:  # noqa: BLE001
        return False


# ---------------------------------------------------------------- OOXML readers
def _zip_text(zf: zipfile.ZipFile, name: str) -> str:
    try:
        return zf.read(name).decode("utf-8", "replace")
    except KeyError:
        return ""


def _shared_strings(zf: zipfile.ZipFile) -> list[str]:
    xml = _zip_text(zf, "xl/sharedStrings.xml")
    if not xml:
        return []
    root = ET.fromstring(xml)
    ns = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    out = []
    for si in root.findall(f"{ns}si"):
        out.append("".join(t.text or "" for t in si.iter(f"{ns}t")))
    return out


def xlsx_to_html(path: str, max_rows: int = 200, max_cols: int = 40) -> str:
    ns = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    with zipfile.ZipFile(path) as zf:
        shared = _shared_strings(zf)
        sheets = [n for n in zf.namelist() if re.match(r"xl/worksheets/sheet\d+\.xml$", n)]
        sheets.sort(key=lambda n: int(re.search(r"(\d+)", os.path.basename(n)).group(1)))
        parts = []
        for idx, name in enumerate(sheets[:12], 1):
            root = ET.fromstring(_zip_text(zf, name))
            rows = []
            truncated = False
            for r_i, row in enumerate(root.iter(f"{ns}row")):
                if r_i >= max_rows:
                    truncated = True
                    break
                cells = []
                for c_i, c in enumerate(row.findall(f"{ns}c")):
                    if c_i >= max_cols:
                        truncated = True
                        break
                    v = c.find(f"{ns}v")
                    is_t = c.find(f"{ns}is")
                    val = ""
                    if c.get("t") == "s" and v is not None:
                        i = int(v.text or 0)
                        val = shared[i] if 0 <= i < len(shared) else ""
                    elif is_t is not None:
                        val = "".join(t.text or "" for t in is_t.iter(f"{ns}t"))
                    elif v is not None:
                        val = v.text or ""
                    cells.append(f"<td>{html.escape(val)}</td>")
                if cells:
                    rows.append("<tr>" + "".join(cells) + "</tr>")
            if rows:
                note = " <em>（表格较大，只显示前 %d 行 × %d 列）</em>" % (max_rows, max_cols) if truncated else ""
                parts.append(f"<h3>Sheet {idx}{note}</h3><div class=tw><table>"
                             + "".join(rows) + "</table></div>")
        return "".join(parts) or "<p>（空表格）</p>"


def _img_data_uri(data: bytes, ext: str, max_w: int = 1280) -> str | None:
    """把内嵌图缩到手机友好的尺寸再转 data URI；EMF/WMF 之类交给浏览器试。"""
    ext = ext.lstrip(".").lower()
    if ext in ("emf", "wmf"):
        return None
    try:
        import io
        from PIL import Image
        im = Image.open(io.BytesIO(data))
        if im.width > max_w:
            im = im.resize((max_w, max(1, round(im.height * max_w / im.width))), Image.LANCZOS)
        buf = io.BytesIO()
        im.convert("RGB").save(buf, "JPEG", quality=80, optimize=True)
        return "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode()
    except Exception:  # noqa: BLE001
        mime = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg",
                "gif": "image/gif", "svg": "image/svg+xml"}.get(ext)
        return (f"data:{mime};base64," + base64.b64encode(data).decode()) if mime else None


def pptx_to_html(path: str, media_dir: str, max_imgs_per_slide: int = 6) -> str:
    a = "{http://schemas.openxmlformats.org/drawingml/2006/main}"
    rel_ns = "{http://schemas.openxmlformats.org/package/2006/relationships}"
    with zipfile.ZipFile(path) as zf:
        slides = sorted([n for n in zf.namelist() if re.match(r"ppt/slides/slide\d+\.xml$", n)],
                        key=lambda n: int(re.search(r"(\d+)", os.path.basename(n)).group(1)))
        os.makedirs(media_dir, exist_ok=True)
        out = []
        for i, name in enumerate(slides, 1):
            root = ET.fromstring(_zip_text(zf, name))
            texts = [t.text for t in root.iter(f"{a}t") if t.text and t.text.strip()]
            # 该 slide 引用的图片（r:embed -> ppt/media/...）
            embeds = [e.get("{http://schemas.openxmlformats.org/officeDocument/2006/relationships}embed")
                      for e in root.iter() if e.tag.endswith("}blip")]
            imgs = []
            rels = _zip_text(zf, name.replace("slides/", "slides/_rels/") + ".rels")
            rmap = {}
            if rels:
                for rel in ET.fromstring(rels).findall(f"{rel_ns}Relationship"):
                    rmap[rel.get("Id")] = rel.get("Target")
            for e in embeds[:max_imgs_per_slide]:
                tgt = rmap.get(e, "")
                if not tgt:
                    continue
                member = os.path.normpath(os.path.join("ppt/slides", tgt)).replace("\\", "/")
                if member not in zf.namelist():
                    continue
                uri = _img_data_uri(zf.read(member), os.path.splitext(member)[1])
                if uri:
                    imgs.append(f'<img loading=lazy src="{uri}">')
            body = "".join(f"<p>{html.escape(t)}</p>" for t in texts)
            out.append(f"<section class=slide><h3>第 {i} 页</h3>{body}{''.join(imgs)}</section>")
        return "".join(out) or "<p>（没有可提取的内容）</p>"


def convert_doc(src: str, web: str, cache: dict) -> dict:
    """Return {'kind': 'pdf'|'html', 'href': URL} for a document."""
    rel = os.path.relpath(src, MEDIA_ROOT)
    ext = os.path.splitext(src)[1].lower()
    slug = re.sub(r"[^A-Za-z0-9_.-]", "_", rel)[:120]
    if ext == ".pdf":
        res = {"kind": "pdf", "href": "media/" + quote_path(rel)}
    elif ext == ".txt":
        dest = f"docs/{slug}.html"
        body = "<pre>" + html.escape(open(src, encoding="utf-8", errors="replace").read()) + "</pre>"
        write_doc(web, dest, "文本", body)
        res = {"kind": "html", "href": dest}
    elif ext == ".docx":
        dest = f"docs/{slug}.html"
        os.makedirs(os.path.join(web, "docs"), exist_ok=True)
        tmp = os.path.join(web, "docs", f".{slug}.tmp.html")
        cmd = ["pandoc", "-f", "docx", "-t", "html5", "--embed-resources",
               "--standalone", "--metadata", "title=" + os.path.basename(src),
               "-o", tmp, src]
        ok = shutil.which("pandoc") and subprocess.run(
            cmd, capture_output=True).returncode == 0 and os.path.exists(tmp)
        if ok:
            shutil.move(tmp, os.path.join(web, dest.lstrip("/")))
            res = {"kind": "html", "href": dest}
        else:
            res = {"kind": "download", "href": "media/" + quote_path(rel)}
    elif ext == ".xlsx":
        dest = f"docs/{slug}.html"
        write_doc(web, dest, os.path.basename(src), xlsx_to_html(src))
        res = {"kind": "html", "href": dest}
    elif ext == ".pptx":
        dest = f"docs/{slug}.html"
        write_doc(web, dest, os.path.basename(src),
                  pptx_to_html(src, os.path.join(web, "docs", "media")))
        res = {"kind": "html", "href": dest}
    else:
        res = {"kind": "download", "href": "media/" + quote_path(rel)}
    return res


def quote_path(rel: str) -> str:
    from urllib.parse import quote
    return quote(rel)


def write_doc(web: str, dest: str, title: str, body: str):
    os.makedirs(os.path.dirname(os.path.join(web, dest.lstrip("/"))), exist_ok=True)
    page = f"""<!doctype html><html lang=zh><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1">
<title>{html.escape(title)}</title>
<link rel=stylesheet href="../style.css"></head><body class=doc>
<p><a href="../">← 返回列表</a></p><h1>{html.escape(title)}</h1>
{body}
</body></html>"""
    with open(os.path.join(web, dest.lstrip("/")), "w", encoding="utf-8") as fh:
        fh.write(page)


