#!/usr/bin/env python3
"""Serve every Quartz site in sites.conf on its own port.

Runs one HTTP listener per site on 127.0.0.1 and on the Tailscale address (so
`tailscale serve` can proxy it with HTTPS while the port stays off the LAN).
Each listener adds what Quartz needs from a static host:

  * clean URL  -> `<path>.html` (and `<path>/index.html`)
  * unknown    -> `404.html` (status 404, like GitHub Pages, so the SPA runs)

It is designed to run under `systemd --user` (see ../setup.sh).

Usage: quartz-web-serve            # uses ../sites.conf
Env:   QUARTZ_WEB_OUT, QUARTZ_WEB_SITES, QUARTZ_WEB_BIND
"""
from __future__ import annotations

import os
import signal
import sys
import threading
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.realpath(__file__))
CONF = os.environ.get("QUARTZ_WEB_SITES", os.path.join(HERE, "..", "sites.conf"))
OUT_ROOT = os.environ.get("QUARTZ_WEB_OUT", os.path.expanduser("~/Code/self/quartz-sites"))


def tailscale_ip() -> str | None:
    try:
        import subprocess

        out = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=5)
        return out.stdout.split()[0] if out.returncode == 0 and out.stdout.split() else None
    except Exception:  # noqa: BLE001
        return None


def make_handler(root: str):
    class Handler(SimpleHTTPRequestHandler):
        def __init__(self, *a, **kw):
            super().__init__(*a, directory=root, **kw)

        def translate_path(self, path):
            p = super().translate_path(path)
            if os.path.isfile(p):
                return p
            if os.path.isdir(p):
                idx = os.path.join(p, "index.html")
                if os.path.isfile(idx):
                    return idx
            if os.path.isfile(p + ".html"):
                return p + ".html"
            return p

        def send_error(self, code, message=None, explain=None):
            if code == 404:
                fallback = os.path.join(root, "404.html")
                if os.path.isfile(fallback):
                    with open(fallback, "rb") as fh:
                        data = fh.read()
                    self.send_response(404)
                    self.send_header("Content-Type", "text/html; charset=utf-8")
                    self.send_header("Content-Length", str(len(data)))
                    self.end_headers()
                    if self.command != "HEAD":
                        self.wfile.write(data)
                    return
            super().send_error(code, message, explain)

        def log_message(self, fmt, *args):
            sys.stderr.write(
                f"[{root.rsplit('/', 2)[-2]}] {self.address_string()} {fmt % args}\n"
            )

    return Handler


def parse_sites():
    sites = []
    with open(CONF, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("|")
            if len(parts) < 6:
                continue
            name, _vault, _title, _short, local_port, _serve_port = parts[:6]
            sites.append((name, int(local_port)))
    return sites


def main() -> None:
    addrs = ["127.0.0.1"]
    ts_ip = tailscale_ip()
    if ts_ip:
        addrs.append(ts_ip)

    servers = []
    for name, port in parse_sites():
        root = os.path.join(OUT_ROOT, name, "public")
        if not os.path.isdir(root):
            print(f"[quartz-web] skip {name}: not built yet ({root})", file=sys.stderr)
            continue
        handler = make_handler(root)
        for addr in addrs:
            try:
                srv = ThreadingHTTPServer((addr, port), handler)
            except OSError as exc:
                print(f"[quartz-web] cannot bind {addr}:{port}: {exc}", file=sys.stderr)
                continue
            servers.append(srv)
            threading.Thread(target=srv.serve_forever, daemon=True).start()
            print(f"[quartz-web] {name}: http://{addr}:{port}/ -> {root}", file=sys.stderr)

    if not servers:
        sys.exit("[quartz-web] no sites to serve")

    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    stop.wait()
    for srv in servers:
        srv.shutdown()


if __name__ == "__main__":
    main()
