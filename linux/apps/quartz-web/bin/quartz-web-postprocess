#!/usr/bin/env python3
"""Post-process a Quartz build so the site is browsable and installable as an app.

Given a built site directory, its source vault and the public path prefix it is
served under, this:

  1. copies the PWA assets (manifest, icon, service worker) into the site root;
  2. injects the "add to home screen" <head> tags into every generated page;
  3. writes a root `index.html` — a redirect to the vault's home note when it
     has one, otherwise a landing page listing the top-level folders;
  4. repairs internal links that point at no page in the build (see
     `repair_internal_links`).

Everything is prefixed with the public path because the site is served under
`https://<tailnet>/<prefix>/` (Tailscale Serve strips the prefix before it
reaches the local server, but the browser must still see the full path).

Quartz links to clean URLs (no `.html`), and its `shortest` link resolution can
put a note at a different path than its folder, so the home note is resolved by
scanning the vault rather than guessing.

Usage: quartz-web-postprocess <site_dir> <vault_dir> <name> <title> <short> <base_path>
"""
from __future__ import annotations

import html
import os
import re
import shutil
import sys
import urllib.parse

HERE = os.path.dirname(os.path.realpath(__file__))
ASSETS = os.path.join(HERE, "..", "assets")

HOME_NAMES = ("index.md", "首页.md", "Home.md", "home.md", "README.md", "readme.md")

HEAD_TAGS = (
    '<link rel="manifest" href="{prefix}/manifest.webmanifest">'
    '<link rel="icon" href="{prefix}/icon.png">'
    '<link rel="apple-touch-icon" href="{prefix}/icon.png">'
    '<meta name="theme-color" content="#161618">'
    '<meta name="mobile-web-app-capable" content="yes">'
    '<meta name="apple-mobile-web-app-capable" content="yes">'
    '<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">'
    '<meta name="apple-mobile-web-app-title" content="{short}">'
    '<script>if("serviceWorker" in navigator){{navigator.serviceWorker'
    '.register("{prefix}/sw.js").catch(function(){{}})}}</script>'
)


def find_home(vault: str) -> str | None:
    """Return the vault-relative path of the home note, if any."""
    for depth in (0, 1):
        for name in HOME_NAMES:
            if depth == 0:
                if os.path.isfile(os.path.join(vault, name)):
                    return name
            else:
                for entry in sorted(os.listdir(vault)):
                    if not os.path.isdir(os.path.join(vault, entry)):
                        continue
                    if os.path.isfile(os.path.join(vault, entry, name)):
                        return os.path.join(entry, name)
    return None


def write_redirect(path: str, title: str, url: str) -> None:
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(
            '<!doctype html><html lang="zh"><head><meta charset="utf-8">'
            f'<meta http-equiv="refresh" content="0; url={html.escape(url)}">'
            f"<title>{html.escape(title)}</title></head>"
            f'<body><a href="{html.escape(url)}">进入 {html.escape(title)}</a></body></html>\n'
        )


def write_listing(path: str, vault: str, title: str, prefix: str) -> None:
    """Landing page for a vault without a home note (e.g. a folder-only vault)."""
    entries = []
    for entry in sorted(os.listdir(vault)):
        full = os.path.join(vault, entry)
        if entry.startswith(".") or entry.startswith("Untitled"):
            continue
        if os.path.isdir(full):
            href = prefix + "/" + urllib.parse.quote(entry) + "/"
            n = sum(len(f) for _, _, f in os.walk(full))
            entries.append((entry, href, f"{n} 个文件"))
        elif entry.lower().endswith((".base", ".canvas")):
            continue
    rows = "\n".join(
        f'<li><a href="{href}">{html.escape(label)}</a> <span>{meta}</span></li>'
        for label, href, meta in entries
    )
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(f"""<!doctype html><html lang="zh"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{html.escape(title)}</title>
<style>
 body{{font-family:system-ui,-apple-system,"Noto Sans CJK SC",sans-serif;margin:0;
   padding:32px 20px;background:#faf8f8;color:#2b2b2b}}
 @media (prefers-color-scheme:dark){{body{{background:#161618;color:#ebebec}}}}
 h1{{font-size:22px;margin:0 0 4px}} p.sub{{color:#888;margin:0 0 24px;font-size:13px}}
 ul{{list-style:none;padding:0;max-width:640px}}
 li{{display:flex;justify-content:space-between;gap:12px;padding:14px 16px;margin-bottom:8px;
   background:#fff;border-radius:10px;box-shadow:0 1px 4px #0001}}
 @media (prefers-color-scheme:dark){{li{{background:#232326;box-shadow:none}}}}
 a{{text-decoration:none;color:#284b63;font-weight:600}}
 @media (prefers-color-scheme:dark){{a{{color:#7b97aa}}}}
 span{{color:#999;font-size:12px;white-space:nowrap}}
</style></head><body>
<h1>{html.escape(title)}</h1>
<p class="sub">Quartz 只读镜像 · 目录</p>
<ul>
{rows}
</ul>
</body></html>
""")


ANCHOR_TAG_RE = re.compile(r"<a\b[^>]*>")
HREF_ATTR_RE = re.compile(r'(href=")([^"]*)(")')
SLUG_ATTR_RE = re.compile(r'(data-slug=")([^"]*)(")')
EXTERNAL_PREFIXES = ("mailto:", "tel:", "http:", "https:", "data:", "javascript:", "//", "#")
# AliasRedirects emits a tiny page with a meta refresh at every path a note is
# *not* served from (Quartz lowercases slugs, the vault does not).  Such a page
# is a valid link target, but a real page is the better one to point at.
STUB_MARKER = 'http-equiv="refresh"'
STUB_MAX_BYTES = 4096


def _servable(site_dir: str, url_path: str) -> bool:
    """True when quartz-web-serve would find a page at this site-relative path."""
    full = os.path.join(site_dir, url_path)
    if os.path.isfile(full):
        return True
    if os.path.isdir(full) and os.path.isfile(os.path.join(full, "index.html")):
        return True
    return os.path.isfile(full + ".html")


def _is_redirect_stub(path: str) -> bool:
    """True for the tiny meta-refresh pages AliasRedirects emits."""
    if os.path.getsize(path) >= STUB_MAX_BYTES:
        return False
    with open(path, encoding="utf-8", errors="replace") as fh:
        return STUB_MARKER in fh.read()


def _page_index(site_dir: str) -> dict[str, dict[str, bool]]:
    """basename(lowercased) -> {site-relative path: is_redirect_stub}."""
    index: dict[str, dict[str, bool]] = {}
    for dirpath, _dirnames, filenames in os.walk(site_dir):
        rel_dir = os.path.relpath(dirpath, site_dir)
        rel_dir = "" if rel_dir == "." else rel_dir.replace(os.sep, "/")
        candidates = []
        if "index.html" in filenames:
            candidates.append((os.path.join(dirpath, "index.html"), rel_dir))
        for fn in filenames:
            if fn.endswith(".html") and fn != "index.html":
                path = f"{rel_dir}/{fn[:-5]}".lstrip("/")
                candidates.append((os.path.join(dirpath, fn), path))
        for full, path in candidates:
            if not path or path == "404":
                continue
            try:
                stub = _is_redirect_stub(full)
            except OSError:
                stub = False
            index.setdefault(os.path.basename(path).lower(), {})[path] = stub
    return index


def _page_url(prefix: str, rel_path: str) -> str:
    """Browser URL of a built page (folder pages end in `/`, like the clean URL)."""
    if rel_path.endswith("index.html"):
        return f"{prefix}/{rel_path[:-len('index.html')]}"
    return f"{prefix}/{rel_path}"


def _pick_target(
    index: dict[str, dict[str, bool]], src_slug: str, base: str
) -> str | None:
    """Best existing page whose basename is `base`, or None.

    Mirrors how Obsidian resolves a bare `[[note]]`: prefer the only match, then
    a sibling of the linking note, then the shallowest path.  Redirect stubs are
    only used when there is no real page to point at.
    """
    found = index.get(base, {})
    candidates = [p for p in found if p != src_slug]
    if not candidates:
        return None
    pool = [p for p in candidates if not found[p]] or candidates
    siblings = [p for p in pool if os.path.dirname(p) == os.path.dirname(src_slug)]
    if len(pool) == 1:
        return pool[0]
    if len(siblings) == 1:
        return siblings[0]
    return min(pool, key=lambda p: (p.count("/"), p))


def repair_internal_links(site_dir: str, prefix: str) -> tuple[int, int]:
    """Point internal links at a page that exists in the build.

    Quartz's `shortest` link resolution falls back to a site-absolute path when
    a bare `[[note]]` matches more than one file (this vault has 392 duplicated
    basenames, e.g. `知识库/首页.md` vs `知识库/SOP主线/首页.md`) and when the
    case of a linked folder differs from its slug.  It also emits tag links
    relative to the wrong depth.  None of those paths exist, so the link lands
    on `404.html`.  Rather than editing the vault (read-only by design), fix the
    hrefs in the build: resolve them the way Obsidian would.
    """
    index = _page_index(site_dir)
    pages = links = 0

    def rewrite_tag(tag: str, page_url: str, src_slug: str) -> str:
        href_match = HREF_ATTR_RE.search(tag)
        if href_match is None:
            return tag
        raw = html.unescape(href_match.group(2))
        if not raw or raw.startswith(EXTERNAL_PREFIXES):
            return tag
        split = urllib.parse.urlsplit(urllib.parse.urljoin(page_url, raw))
        path = urllib.parse.unquote(split.path)
        if not path.startswith("/"):
            path = "/" + path

        rel: str | None = None
        if path.startswith(prefix + "/") or path == prefix:
            rel = path[len(prefix) :].lstrip("/")
            if _servable(site_dir, rel):
                return tag
        else:
            # Relative link that climbed out of the mounted prefix, e.g. a tag
            # link Quartz rendered relative to the wrong depth.
            inner = path.lstrip("/")
            if _servable(site_dir, inner):
                return _set_attrs(tag, inner, split.fragment, prefix, site_dir)
            rel = inner

        base = rel.rstrip("/").split("/")[-1].lower()
        target = _pick_target(index, src_slug, base)
        if target is None:
            return tag
        if target == src_slug:
            return tag
        return _set_attrs(tag, target, split.fragment, prefix, site_dir)

    for dirpath, _dirnames, filenames in os.walk(site_dir):
        for fn in filenames:
            if not fn.endswith(".html"):
                continue
            full = os.path.join(dirpath, fn)
            rel_path = os.path.relpath(full, site_dir).replace(os.sep, "/")
            src_slug = rel_path[:-5]
            if src_slug.endswith("/index"):
                src_slug = src_slug[: -len("/index")]
            page_url = _page_url(prefix, rel_path)
            src = open(full, encoding="utf-8").read()
            changed = 0

            def sub(match: re.Match[str]) -> str:
                nonlocal changed
                new = rewrite_tag(match.group(0), page_url, src_slug)
                if new != match.group(0):
                    changed += 1
                return new

            new_src = ANCHOR_TAG_RE.sub(sub, src)
            if changed:
                with open(full, "w", encoding="utf-8") as fh:
                    fh.write(new_src)
                pages += 1
                links += changed
    return pages, links


def _set_attrs(tag: str, target: str, fragment: str, prefix: str, site_dir: str) -> str:
    """Repoint one `<a>` at `target` (a site-relative path) plus its data-slug.

    Both the URL and the slug keep a trailing `/` for folder pages: Quartz uses
    that form for its own folder links, and the SPA/popover code relies on it
    (a folder URL without the slash makes every relative link on the page
    resolve one directory too high).
    """
    is_dir = os.path.isdir(os.path.join(site_dir, target))
    tail = "/" if is_dir else ""
    href = f"{prefix}/{target}{tail}" + (f"#{fragment}" if fragment else "")
    escaped = html.escape(href, quote=True)
    tag = HREF_ATTR_RE.sub(lambda m: m.group(1) + escaped + m.group(3), tag, count=1)
    if SLUG_ATTR_RE.search(tag):
        slug = html.escape(f"{target}{tail}", quote=True)
        tag = SLUG_ATTR_RE.sub(lambda m: m.group(1) + slug + m.group(3), tag, count=1)
    return tag


def main() -> None:
    site_dir, vault, name, title, short, base_path = sys.argv[1:7]
    prefix = base_path.rstrip("/")

    # 1. PWA assets
    shutil.copyfile(os.path.join(ASSETS, "icon.png"), os.path.join(site_dir, "icon.png"))
    shutil.copyfile(os.path.join(ASSETS, "sw.js"), os.path.join(site_dir, "sw.js"))
    tmpl = open(os.path.join(ASSETS, "manifest.webmanifest.tmpl"), encoding="utf-8").read()
    manifest = (
        tmpl.replace("__APP_NAME__", title)
        .replace("__APP_SHORT_NAME__", short)
        .replace("__APP_DESC__", f"{title} · Quartz 只读镜像")
        .replace("__START_URL__", prefix + "/")
        .replace("__SCOPE__", prefix + "/")
        .replace("__ICON__", prefix + "/icon.png")
    )
    with open(os.path.join(site_dir, "manifest.webmanifest"), "w", encoding="utf-8") as fh:
        fh.write(manifest)

    # 2. inject head tags
    tags = HEAD_TAGS.format(short=html.escape(short), prefix=prefix)
    injected = 0
    for dirpath, _dirnames, filenames in os.walk(site_dir):
        for fn in filenames:
            if not fn.endswith(".html"):
                continue
            p = os.path.join(dirpath, fn)
            src = open(p, encoding="utf-8").read()
            if 'rel="manifest"' in src:
                continue
            i = src.find("</head>")
            if i < 0:
                continue
            with open(p, "w", encoding="utf-8") as fh:
                fh.write(src[:i] + tags + src[i:])
            injected += 1

    # 3. root index
    home = find_home(vault)
    index = os.path.join(site_dir, "index.html")
    if home:
        url = prefix + "/" + urllib.parse.quote(home[:-3])  # strip .md -> clean URL
        write_redirect(index, title, url)
    else:
        write_listing(index, vault, title, prefix)
    # 4. internal links that would 404
    pages, links = repair_internal_links(site_dir, prefix)

    print(
        f"[post] {name}: prefix={prefix or '/'} PWA tags in {injected} pages, "
        f"home={home or '(listing)'}, repaired {links} links in {pages} pages"
    )


if __name__ == "__main__":
    main()
