#!/usr/bin/env python3
"""Make upstream web apps installable as apps, without touching their code.

Runs a reverse proxy per entry in wrapped.tsv. For each upstream it:

  * serves `/__pwa/{manifest.webmanifest,icon.png,sw.js,register.js}` itself;
  * injects the PWA <head> tags into every proxied `text/html` response;
  * streams `text/event-stream` through untouched (no buffering) and passes
    everything else straight back, so auth cookies / redirects keep working.

`Accept-Encoding` is forced to identity so HTML can be rewritten, then the
response's content-encoding/length are recalculated.

Run under `systemd --user` (see ../setup.sh).

Env: TAILNET_PORTAL_WRAPPED, TAILNET_PORTAL_BIND
"""
from __future__ import annotations

import gzip
import http.client
import json
import os
import re
import signal
import sys
import threading
import urllib.parse
import zlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.realpath(__file__))
MODULE = os.path.dirname(HERE)
ASSETS = os.path.join(MODULE, "assets")
CONF = os.environ.get("TAILNET_PORTAL_WRAPPED", os.path.join(MODULE, "wrapped.tsv"))

HOP_BY_HOP = {"connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
              "te", "trailers", "transfer-encoding", "upgrade", "host", "content-length"}

HEAD_TAGS = (
    '<link rel="manifest" href="/__pwa/manifest.webmanifest">'
    '<link rel="icon" href="/__pwa/icon.png">'
    '<link rel="apple-touch-icon" href="/__pwa/icon.png">'
    '<meta name="theme-color" content="#101216">'
    '<meta name="mobile-web-app-capable" content="yes">'
    '<meta name="apple-mobile-web-app-capable" content="yes">'
    '<meta name="apple-mobile-web-app-title" content="{short}">'
    '<script src="/__pwa/register.js"></script>'
)

REGISTER_JS = (
    'if("serviceWorker" in navigator){navigator.serviceWorker'
    '.register("/__pwa/sw.js",{scope:"/"}).catch(function(){})}\n'
)

MANIFEST = """{
  "name": "%(name)s",
  "short_name": "%(short)s",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#101610",
  "theme_color": "#101216",
  "icons": [
    {"src": "/__pwa/icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/__pwa/icon.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
"""


def read_conf():
    sites = []
    with open(CONF, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("|")
            if len(parts) < 6:
                continue
            name, upstream, port, app, short, icon = (p.strip() for p in parts[:6])
            token_log = parts[6].strip() if len(parts) > 6 else ""
            sites.append({"name": name, "upstream": upstream, "port": int(port),
                          "app": app, "short": short, "icon": icon,
                          "token_log": os.path.expanduser(token_log) if token_log else "",
                          "mount": parts[7].strip().rstrip("/") if len(parts) > 7 else ""})
    return sites


def read_token(path: str) -> str | None:
    """Read the `?token=...` an upstream printed on startup. Re-read every time
    because the token changes on restart."""
    if not path:
        return None
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return None
    match = re.search(r"[?&]token=([A-Za-z0-9_.\-]+)", text)
    return match.group(1) if match else None


def make_handler(site):
    up = urllib.parse.urlsplit(site["upstream"])
    mount = site.get("mount", "")
    if mount and not re.fullmatch(r"/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*", mount):
        raise ValueError("invalid PWA mount path")
    tags = HEAD_TAGS.format(short=site["short"]).replace("/__pwa/", mount + "/__pwa/")
    manifest = (MANIFEST % {"name": site["app"], "short": site["short"]}).encode()
    if mount:
        metadata = json.loads(manifest)
        metadata.update(id=mount+"/", start_url=mount+"/", scope=mount+"/")
        for entry in metadata["icons"]: entry["src"] = mount + entry["src"]
        manifest = json.dumps(metadata, ensure_ascii=False).encode()
    register = REGISTER_JS.replace("/__pwa/", mount+"/__pwa/").replace('scope:"/"', 'scope:"'+mount+'/"')
    with open(os.path.join(ASSETS, site["icon"]), "rb") as fh:
        icon = fh.read()
    with open(os.path.join(ASSETS, "sw.js"), "rb") as fh:
        worker = fh.read()

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "tailnet-pwa-proxy"

        def log_message(self, fmt, *args):
            sys.stderr.write(f"[{site['name']}] {self.address_string()} {fmt % args}\n")

        def _local(self, body: bytes, ctype: str, code: int = 200, extra=None):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            for k, v in (extra or []):
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def _proxy(self):
            proxy_path = self.path
            if mount:
                pathname = urllib.parse.urlsplit(self.path).path
                if pathname in ("/manifest.webmanifest", "/__pwa/manifest.webmanifest"):
                    return self._local(manifest, "application/manifest+json")
                if pathname == mount:
                    return self._local(b"", "text/plain", 302, [("Location", mount+"/" + ("?"+urllib.parse.urlsplit(self.path).query if urllib.parse.urlsplit(self.path).query else ""))])
                if not self.path.startswith(mount+"/"):
                    return self._local(b"", "text/plain", 302, [("Location", mount+self.path)])
                proxy_path = self.path[len(mount):]
            if proxy_path.startswith("/__pwa/"):
                p = proxy_path.split("?")[0]
                if p.endswith("manifest.webmanifest"):
                    return self._local(manifest, "application/manifest+json")
                if p.endswith("icon.png"):
                    return self._local(icon, "image/png")
                if p.endswith("sw.js"):
                    # Widen from the worker directory to this app mount only.
                    return self._local(worker,
                                       "text/javascript",
                                       extra=[("Service-Worker-Allowed", mount+"/")])
                if p.endswith("register.js"):
                    return self._local(register.encode(), "text/javascript")
                return self._local(b"not found", "text/plain", 404)

            length = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(length) if length else None
            headers = {k: v for k, v in self.headers.items()
                       if k.lower() not in HOP_BY_HOP}
            headers["Accept-Encoding"] = "identity"
            headers["Host"] = up.netloc
            if mount:
                headers = {k: v for k, v in headers.items()
                           if k.lower() not in ("if-none-match", "if-modified-since")}

            conn = http.client.HTTPConnection(up.hostname, up.port, timeout=120)
            try:
                # Read mounted HEAD as GET so transformed representation metadata matches.
                upstream_method = "GET" if mount and self.command == "HEAD" else self.command
                conn.request(upstream_method, proxy_path, body=body, headers=headers)
                resp = conn.getresponse()
            except Exception as exc:  # noqa: BLE001
                return self._local(f"upstream error: {exc}".encode(), "text/plain", 502)

            ctype = resp.getheader("Content-Type", "")

            # Upstream wants `?token=`: bounce once so the browser picks up the
            # auth cookie, instead of showing "authentication required".
            if resp.status == 401 and site["token_log"] and "token=" not in self.path:
                token = read_token(site["token_log"])
                conn.close()
                if token:
                    location = mount + "/?token=" + token
                    self.send_response(303)
                    self.send_header("Location", location)
                    self.send_header("Content-Length", "0")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    return
                return self._local(b"upstream requires auth and no token found in "
                                   + site["token_log"].encode(), "text/plain", 502)

            passthrough = [(k, v) for k, v in resp.getheaders()
                           if k.lower() not in HOP_BY_HOP
                           and k.lower() not in ("content-length", "content-encoding")]

            if "text/event-stream" in ctype:
                self.send_response(resp.status)
                for k, v in passthrough:
                    self.send_header(k, v)
                self.send_header("Transfer-Encoding", "chunked")
                self.end_headers()
                while True:
                    chunk = resp.read(1024)
                    if not chunk:
                        break
                    self.wfile.write(b"%x\r\n%s\r\n" % (len(chunk), chunk))
                    self.wfile.flush()
                self.wfile.write(b"0\r\n\r\n")
                self.wfile.flush()
                conn.close()
                return

            data = resp.read()
            conn.close()
            # Some upstreams gzip regardless of Accept-Encoding (serve-knowledge
            # does), so decode here since we drop content-encoding downstream.
            enc = (resp.getheader("Content-Encoding") or "").lower()
            try:
                if data and "gzip" in enc:
                    data = gzip.decompress(data)
                elif data and "deflate" in enc:
                    data = zlib.decompress(data)
            except Exception as exc:  # noqa: BLE001
                return self._local(f"cannot decode upstream body: {exc}".encode(),
                                   "text/plain", 502)
            if mount and data and proxy_path.split("?")[0] == "/graph.json" and "application/json" in ctype:
                def rewrite_links(value):
                    if isinstance(value, list): return [rewrite_links(x) for x in value]
                    if isinstance(value, dict):
                        return {k: mount+v if k=="href" and isinstance(v,str) and v.startswith("/") and not v.startswith("//") else rewrite_links(v) for k,v in value.items()}
                    return value
                data = json.dumps(rewrite_links(json.loads(data))).encode()
            if mount and "javascript" in ctype:
                data = data.replace(b'fetch("/graph.json")', ('fetch("'+mount+'/graph.json")').encode())
            if "text/html" in ctype:
                text = data.decode("utf-8", "replace")
                if mount:
                    text = re.sub(r"<link\b[^>]*\brel=[\"']manifest[\"'][^>]*>", "", text, flags=re.I)
                    text = re.sub(r"((?:href|src|action)=[\"'])/(?!/)", lambda m: m.group(1)+mount+"/", text)
                    text = text.replace('fetch("/graph.json")', 'fetch("'+mount+'/graph.json")')
                i = text.find("</head>")
                if i >= 0 and 'name="tailnet-pwa"' not in text:
                    text = (text[:i] + '<!-- tailnet-pwa -->' + tags + text[i:])
                data = text.encode("utf-8")

            self.send_response(resp.status)
            for k, v in passthrough:
                if mount and k.lower() in ("etag", "cache-control"):
                    continue
                if mount and k.lower() == "location" and v.startswith("/") and not v.startswith("//"):
                    v = mount + v
                self.send_header(k, v)
            if mount:
                self.send_header("Cache-Control", "no-cache")
            self.send_header("Content-Length", resp.getheader("Content-Length", "0") if self.command == "HEAD" and not mount else str(len(data)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(data)

        do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = do_OPTIONS = _proxy

    return Handler


def main() -> None:
    bind = os.environ.get("TAILNET_PORTAL_BIND") or "127.0.0.1"
    servers = []
    for site in read_conf():
        try:
            srv = ThreadingHTTPServer((bind, site["port"]), make_handler(site))
        except OSError as exc:
            print(f"[pwa-proxy] cannot bind {bind}:{site['port']}: {exc}", file=sys.stderr)
            continue
        servers.append(srv)
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        print(f"[pwa-proxy] {site['name']}: http://{bind}:{site['port']}/ -> {site['upstream']}",
              file=sys.stderr)

    if not servers:
        sys.exit("[pwa-proxy] nothing to serve")

    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    stop.wait()
    for srv in servers:
        srv.shutdown()


if __name__ == "__main__":
    main()
