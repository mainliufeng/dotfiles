{
    "languageserver": {
        "golang": {
            "command": "coc-go",
            "rootPatterns": ["go.mod"],
            "filetypes": ["go"]
        }
    },
    "go.goplsOptions": {
        "completeUnimported": true,
        "fuzzyMatching": true,
        "usePlaceholders": true
    }
}
