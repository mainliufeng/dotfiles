{
    "languageserver": {
        "golang": {
            "command": "gopls",
            "rootPatterns": ["go.mod"],
            "filetypes": ["go"],
            "disableWorkspaceFolders": true
        }
    },
    "go.goplsOptions": {
        "completeUnimported": true,
        "fuzzyMatching": true,
        "usePlaceholders": false
    }
}
