# Keep Telegram's two persistent HTTP pools below macOS launchd's default
# 256-file soft limit. Hermes v0.20.0 otherwise allows 512 connections per
# pool, so proxy reconnects can exhaust the gateway before pool recovery runs.
HERMES_TELEGRAM_HTTP_POOL_SIZE=32

# Minimize idle proxy sockets retained by long-lived platform clients.
HERMES_GATEWAY_HTTPX_MAX_KEEPALIVE=4
HERMES_GATEWAY_HTTPX_KEEPALIVE_EXPIRY=1
