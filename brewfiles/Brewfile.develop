cask_args appdir: '/Applications'

tap 'homebrew/bundle'
tap 'caskroom/cask'
tap 'Liu-Feng/formulae'

# productive
cask 'iterm2'
cask 'alfred'
mas 'Dash', id: 449589707
brew 'zsh'
brew 'zsh-syntax-highlighting'
brew 'zsh-history-substring-search'
brew 'zsh-completions'
brew 'macvim', args: ['with-override-system-vim']
brew 'tmux'
brew 'fasd'
brew 'tree'
brew 'termtile', args: ['HEAD']
brew 'jsonformat', args: ['HEAD']
brew 'simulate-input-macos', args: ['HEAD']
brew 'fd'  # replace find command

brew 'diff-so-fancy'
brew 'fabric'
brew 'the_silver_searcher'
cask 'sublime-text'
cask 'postman'
mas 'Patterns', id: 429449079

# proxy
brew 'xx-net'
cask 'surge'
brew 'polipo'
cask 'vyprvpn'
cask 'virtualbox'

# vm
cask 'docker'
cask 'parallels-desktop'
brew 'kubernetes-cli'
cask 'minikube'

# ide
brew 'intellij-idea'
cask 'eclipse-java'

# programming
brew 'python'
brew 'python3'
brew 'go'
brew 'maven'
brew 'scala', args: ['with-docs']
brew 'sbt'
brew 'zinc'
brew 'nvm'
brew 'cocoapods'
cask 'java'

brew 'shellcheck'
brew 'ant'
brew 'apache-spark'

# client
brew 'httpie'
brew 'mycli'
brew 'pgcli'
brew 'zookeeper'
cask 'postgres'
cask 'mongohub'
cask 'dbvisualizer'
brew 'mysql'
brew 'postgresql'
brew 'redis'
brew 'memcached'
brew 'mongodb'

# tools
cask 'unetbootin'
cask 'filezilla'
