#compdef agents-md

emulate -L zsh
setopt localoptions nullglob

local -a agents_md_cmds agents_md_fragments agents_md_files
agents_md_cmds=(enable disable status)

agents_md_files=("$HOME/dotfiles/codex/agents_md"/*.md)
agents_md_fragments=(${agents_md_files:t:r})

if (( CURRENT == 2 )); then
  compadd -- $agents_md_cmds
  return
fi

if (( CURRENT >= 3 )); then
  compadd -- $agents_md_fragments
  return
fi
