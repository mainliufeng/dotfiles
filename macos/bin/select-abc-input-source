#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "select-abc-input-source is macOS-only" >&2
  exit 1
fi

tmpfile="$(mktemp "${TMPDIR:-/tmp}/select-abc-input-source.XXXXXX.swift")"
trap 'rm -f "$tmpfile"' EXIT

cat >"$tmpfile" <<'SWIFT'
import Carbon
import Foundation

let sourceID = "com.apple.keylayout.ABC"
let properties = [kTISPropertyInputSourceID as String: sourceID] as CFDictionary
let sources = TISCreateInputSourceList(properties, false).takeRetainedValue() as NSArray

guard let anySource = sources.firstObject else {
  fputs("ABC input source not found\n", stderr)
  exit(1)
}

let source = anySource as! TISInputSource
let status = TISSelectInputSource(source)

if status != noErr {
  fputs("failed to select ABC input source: \(status)\n", stderr)
  exit(1)
}

print("selected ABC (\(sourceID))")
SWIFT

swift "$tmpfile"
