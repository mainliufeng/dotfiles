#!/usr/bin/env bash
set -euo pipefail

launcher="$HOME/dotfiles/macos/bin/codex-app-proxy"

if [[ ! -x "$launcher" ]]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  dotfiles_root="$(cd "$script_dir/../../../../.." && pwd)"
  launcher="$dotfiles_root/macos/bin/codex-app-proxy"
fi

if [[ ! -x "$launcher" ]]; then
  osascript -e 'display alert "Codex Proxy launcher was not found or is not executable."'
  exit 1
fi

exec "$launcher"
