[Desktop Entry]
Type=Application
Name=Antigravity - URL Handler
Comment=Handle antigravity:// URLs
Exec=/bin/sh -c 'extra=""; if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] && { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || case "${XDG_CURRENT_DESKTOP:-}" in *Hyprland*|*hyprland*) true;; *) false;; esac; }; then export ELECTRON_FORCE_DEVICE_SCALE_FACTOR=1; extra="--force-device-scale-factor=1"; fi; exec /usr/bin/antigravity $extra "$@"' sh --open-url %U
Icon=antigravity
Terminal=false
NoDisplay=true
Categories=Development;
MimeType=x-scheme-handler/antigravity;
StartupNotify=true
