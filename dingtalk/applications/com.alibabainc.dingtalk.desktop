[Desktop Entry]
Categories=Chat;Network;
Comment=DingTalk
GenericName=dingtalk
Icon=dingtalk
Keywords=dingtalk;
MimeType=x-scheme-handler/dingtalk;
Name=DingTalk
Name[zh_CN]=钉钉
Type=Application
X-Deepin-Vendor=user-custom

# DingTalk is currently running under XWayland on Hyprland for this setup.
# Force a consistent X11 stack for the app to avoid input issues in embedded views.
Exec=/bin/sh -c 'export QT_QPA_PLATFORM=xcb; export QT_AUTO_SCREEN_SCALE_FACTOR=1; export GDK_BACKEND=x11; export XMODIFIERS=@im=fcitx; export GTK_IM_MODULE=fcitx; export QT_IM_MODULE=fcitx; cd /opt/dingtalk/release && exec ./com.alibabainc.dingtalk "$@"' sh %u

